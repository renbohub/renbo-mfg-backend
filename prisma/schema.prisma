  isDeleted                      Boolean   @default(false) @map("is_deleted")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")
  replanRequired                 Boolean   @default(false) @map("replan_required")
  replanReason                   String?   @map("replan_reason")
  sourceChangedAt                DateTime? @map("source_changed_at")
  lastReplannedAt                DateTime? @map("last_replanned_at")
  planningAnchorMonth            DateTime? @map("planning_anchor_month")
  lifecycleStatus                String    @default("DRAFT") @map("lifecycle_status")
  simulationOnly                 Boolean   @default(false) @map("simulation_only")
  sourceDelta                    Json?     @map("source_delta")
  revision                       Int       @default(0)
  planKind                       String    @default("BASELINE") @map("plan_kind")
  baselineMpsNumber              String?   @map("baseline_mps_number")
  lockedAt                       DateTime? @map("locked_at")
  lockedBy                       String?   @map("locked_by")
  capacityStatus                 String    @default("NOT_CHECKED") @map("capacity_status")
  capacityCheckedAt              DateTime? @map("capacity_checked_at")
  capacityCheckedBy              String?   @map("capacity_checked_by")
  rccpInvalidatedAt              DateTime? @map("rccp_invalidated_at")
  rccpInvalidationReason         String?   @map("rccp_invalidation_reason")
  deliveryFeasibilityStatus      String    @default("UNKNOWN") @map("delivery_feasibility_status")
  deliveryDispositionStatus      String    @default("NONE") @map("delivery_disposition_status")
  officialGateStatus             String    @default("BLOCKED") @map("official_gate_status")
  deliveryFeasibilityCheckedAt   DateTime? @map("delivery_feasibility_checked_at")
  deliveryFeasibilityFingerprint String?   @map("delivery_feasibility_fingerprint")
  deliveryFeasibilityReason      String?   @map("delivery_feasibility_reason")

  // Relations
  details                      MPSDetail[]
  mrpRuns                      MRPRun[]
  deliveryPlans                MPSDeliveryPlan[]
  rccpRuns                     RccpRun[]
  deliveryFeasibilitySnapshots MPSDeliveryFeasibilitySnapshot[]

  @@index([mpsNumber])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([forecastNumber])
  @@index([sourceKey])
  @@index([status])
  @@index([planKind, baselineMpsNumber])
  @@index([isDeleted])
  @@map("tbl_mps")
}

