  uomCode       String?   @map("uom_code")
  revision      Int       @default(1)
  ecnNumber     String?   @map("ecn_number") // Engineering Change Notice number
  status        Status    @default(Draft) // Draft, Pending, Approved, Rejected, Obsolete
