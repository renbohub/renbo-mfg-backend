  uom             Uom?             @relation(fields: [uomCode], references: [uomCode], onDelete: SetNull)

  @@index([noReg])
  @@index([partId])
  @@index([uomCode])
  @@index([status])
  @@index([ecnNumber])
  @@index([isDeleted])
