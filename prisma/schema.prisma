// ============================================
// INVENTORY - STOCK BALANCE
// ============================================

model StockBalance {
  id            String   @id @default(uuid())
  warehouseCode String   @map("warehouse_code")
  rackCode      String?  @map("rack_code") // Kode rak penyimpanan (opsional)
  lotNumber     String?  @map("lot_number") // LOT number untuk traceability (opsional)
  partCode      String?  @map("part_code") // Key stock item: partCode asli (opsional untuk consumable/service)
  partNumber    String?  @map("part_number")
  partName      String?  @map("part_name")
  materialId    String?  @map("material_id")
  materialCode  String?  @map("material_code")
  materialName  String?  @map("material_name")
  materialType  String?  @map("material_type")
  productId     String?  @map("product_id")
  description   String?
  spec          String?
  thickness     Float?   @map("thickness")
  width         Float?
  CSP           String?  @map("CSP")
  uomCode       String?  @map("uom_code") // UOM saldo; menjadi bagian identitas agar qty berbeda UOM tidak tercampur
  stockType     String?  @map("stock_type") // Kategori fisik inventory: Material, Consumable, Asset, Finished Goods, Semi-Finished, dll. Bukan selalu sama dengan poType; reject/scrap/rework dibedakan lewat rack/status.
  qtyOnHand     Float    @default(0) @map("qty_on_hand") // Stock fisik tersedia
  qtyReserved   Float    @default(0) @map("qty_reserved") // Dialokasikan untuk SO/Production
  qtyQC         Float    @default(0) @map("qty_qc") // Stock masih dalam proses QC / inspection
  qtyAvailable  Float    @default(0) @map("qty_available") // qtyOnHand - qtyReserved - qtyQC
  minStock      Float    @default(0) @map("min_stock") // Safety stock minimum
  maxStock      Float?   @map("max_stock") // Maximum stock level
  reorderPoint  Float?   @map("reorder_point") // Trigger untuk reorder
  lastMovement  DateTime @default(now()) @map("last_movement")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  warehouse                    Warehouse                     @relation(fields: [warehouseCode], references: [warehouseCode])
  rack                         Rack?                         @relation(fields: [rackCode], references: [rackCode], onDelete: SetNull)
