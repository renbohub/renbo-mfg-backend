// Official month-end demand baseline. A frozen revision is immutable and is
// the future source contract for MPS; source Forecast/SO remains untouched.
model MonthlyDemandSnapshot {
  id                  String    @id @default(uuid())
  snapshotNumber      String    @unique @map("snapshot_number")
  periodYear          Int       @map("period_year")
  periodMonth         Int       @map("period_month")
  periodStart         DateTime  @map("period_start")
  periodEnd           DateTime  @map("period_end")
  cutoffDate          DateTime  @map("cutoff_date")
  revision            Int       @default(1)
  status              String    @default("DRAFT")
  baseSnapshotId      String?   @map("base_snapshot_id")
  isCurrentRevision   Boolean   @default(true) @map("is_current_revision")
  sourceDataAsOf      DateTime  @default(now()) @map("source_data_as_of")
