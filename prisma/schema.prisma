// RCCP master is intentionally separate from detailed routing. It may be
// bootstrapped from routing, then governed independently as a coarse capacity
// profile for each Finished Good.
model RccpResourceProfile {
  id                     String   @id @default(uuid())
  partId                 String   @map("part_id")
  resourceCode           String   @map("resource_code")
  resourceName           String?  @map("resource_name")
  machineId              String?  @map("machine_id")
  standardTimeHours      Float    @map("standard_time_hours")
  setupTimeHours         Float    @default(0) @map("setup_time_hours")
  resourceCount          Int      @default(1) @map("resource_count")
  shiftsPerDay           Int      @default(2) @map("shifts_per_day")
  effectiveHoursPerShift Float    @default(7) @map("effective_hours_per_shift")
  efficiencyPercent      Float    @default(85) @map("efficiency_percent")
  plannedDowntimeHours   Float    @default(0) @map("planned_downtime_hours")
  calendarMode           String   @default("WEEKDAY") @map("calendar_mode")
  sequence               Int      @default(10)
  resourceType           String   @default("INTERNAL") @map("resource_type")
  leadTimeValue          Float    @default(1) @map("lead_time_value")
  leadTimeUnit           String   @default("WORKING_DAY") @map("lead_time_unit")
