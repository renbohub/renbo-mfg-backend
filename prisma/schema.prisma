// ============================================
// PLANNING - FORECAST
// ============================================

model Forecast {
  id                       String    @id @default(uuid())
  forecastNumber           String    @unique @map("forecast_number")
  forecastName             String?   @map("forecast_name")
  periodStart              DateTime  @map("period_start") // Base period start
  periodEnd                DateTime  @map("period_end") // Base period end
  customerCode             String?   @map("customer_code") // Optional: forecast per customer
  demandBucket             String    @default("PLANNING") @map("demand_bucket") // FIXED, PLANNING, UNOFFICIAL
  versionGroup             String?   @map("version_group")
  version                  Int       @default(1)
  isCurrentVersion         Boolean   @default(true) @map("is_current_version")
  sourceBatchNumber        String?   @map("source_batch_number")
  status                   String    @default("Draft") // Draft, Submitted, Confirmed, Obsolete
  notes                    String?
  revisionOfForecastNumber String?   @map("revision_of_forecast_number")
  revisionNumber           Int       @default(0) @map("revision_number")
  revisionReason           String?   @map("revision_reason")
  createdBy                String?   @map("created_by")
  approvedBy               String?   @map("approved_by")
  approvedDate             DateTime? @map("approved_date")
  isDeleted                Boolean   @default(false) @map("is_deleted")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  // Relations
  details ForecastDetail[]

  @@index([forecastNumber])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([customerCode])
  @@index([demandBucket])
  @@index([versionGroup, version])
  @@index([isCurrentVersion])
  @@index([status])
  @@index([revisionOfForecastNumber])
  @@index([isDeleted])
  @@map("tbl_forecast")
}

// ============================================
// PLANNING - FORECAST DETAIL
// ============================================

model ForecastDetail {
  id             String  @id @default(uuid())
  forecastNumber String  @map("forecast_number")
  lineNumber     Int     @map("line_number")
  partCode       String  @map("part_code")
  partId         String? @map("part_id")
  uomCode        String? @map("uom_code")
  unitPrice      Float   @default(0) @map("unit_price")

  // M+1 Period (Base month + 1)
  M1Forecast DateTime? @map("m1_forecast") // Tanggal forecast M+1
  M1Qty      Float     @default(0) @map("m1_qty") // Forecast qty untuk M+1

  // M+2 Period (Base month + 2)
  M2Forecast DateTime? @map("m2_forecast") // Tanggal forecast M+2
  M2Qty      Float     @default(0) @map("m2_qty")

  // M+3 Period (Base month + 3)
  M3Forecast DateTime? @map("m3_forecast") // Tanggal forecast M+3
  M3Qty      Float     @default(0) @map("m3_qty")

  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  forecast         Forecast               @relation(fields: [forecastNumber], references: [forecastNumber], onDelete: Cascade)
  part             Part?                  @relation(fields: [partId], references: [id], onDelete: SetNull)
  mpsDetails       MPSDetail[]
  mpsDemandSources MPSDemandSource[]
  deliveryTargets  DemandDeliveryTarget[]

  @@index([forecastNumber])
  @@index([partCode])
  @@index([partId])
  @@index([uomCode])
  @@index([isDeleted])
  @@map("tbl_forecast_detail")
}

// ============================================
// PLANNING - MPS (Master Production Schedule)
// ============================================

model MPS {
  id                             String    @id @default(uuid())
  mpsNumber                      String    @unique @map("mps_number")
  mpsName                        String?   @map("mps_name")
  sourceKey                      String?   @unique @map("source_key") // Idempotency: FORECAST:<forecastNumber>:<YYYY-MM>
  periodStart                    DateTime  @map("period_start") // Planning period start
  periodEnd                      DateTime  @map("period_end") // Planning period end
  forecastNumber                 String?   @map("forecast_number") // Reference ke Demand Forecast
  status                         String    @default("Draft") // Draft, Confirmed, Released, Completed
  notes                          String?
  createdBy                      String?   @map("created_by")
  approvedBy                     String?   @map("approved_by")
