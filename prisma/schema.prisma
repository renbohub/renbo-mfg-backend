// ============================================
// PRODUCTION - WORK ORDER
// ============================================

model WorkOrder {
  id                    String              @id @default(uuid())
  woNumber              String              @unique @map("wo_number") // WO-YYYYMMDD-001
  woDate                DateTime            @default(now()) @map("wo_date")
  moId                  String              @map("mo_id") // FK ke ManufacturingOrder
  mbomDetailId          String?             @map("mbom_detail_id") // FK ke MBOMDetail sumber routing/component
  outputPartId          String?             @map("output_part_id")
  outputPartCode        String?             @map("output_part_code")
  outputPartNumber      String?             @map("output_part_number")
  outputPartName        String?             @map("output_part_name")
  isReworkOrder         Boolean             @default(false) @map("is_rework_order")
  reworkSourceType      String?             @map("rework_source_type")
  reworkReferenceType   String?             @map("rework_reference_type")
  reworkReferenceNumber String?             @map("rework_reference_number")
  reworkReferenceLabel  String?             @map("rework_reference_label")
  // Routing reference (dari MBOMProcess)
  processId             String?             @map("process_id") // FK ke Process
  sequence              Int                 @default(0) // Urutan proses dalam routing
  cycleTime             Float               @default(0) @map("cycle_time") // Cycle time per unit (detik), mengikuti MBOMProcess dan Machine
  // Assign ke dies/mesin/operator
  diesId                String?             @map("dies_id")
  machineId             String?             @map("machine_id") // FK ke Machine.id
  machineCostingRate    Float?              @map("machine_costing_rate")
  machineRateType       String?             @map("machine_rate_type")
  machineCurrency       String?             @map("machine_currency")
  plannedProcessCost    Float               @default(0) @map("planned_process_cost")
  actualProcessCost     Float               @default(0) @map("actual_process_cost")
  operatorName          String?             @map("operator_name")
  shift                 String? // 1A, 1B, 2A, 2B, 3A, 3C
  // Schedule
  plannedDate           DateTime            @map("planned_date")
  plannedQty            Float               @map("planned_qty")
  uomCode               String?             @map("uom_code")
  // Realisasi
  shotCount             Int                 @default(0) @map("shot_count") // Diisi saat selesai
  qtyProduced           Float               @default(0) @map("qty_produced")
  qtyGood               Float               @default(0) @map("qty_good")
  qtyReject             Float               @default(0) @map("qty_reject")
  startTime             DateTime?           @map("start_time")
  endTime               DateTime?           @map("end_time")
  runningMinutes        Float?              @map("running_minutes")
  // Status lifecycle: Draft, Planned, Released, Material Issued, In Production, QC Pending, Rework, Completed, Cancelled. Legacy data may still use In Progress.
  status                String              @default("Draft")
  diesUsageId           String?             @unique @map("dies_usage_id") // FK ke DiesUsage yang dibuat otomatis
  notes                 String?
  isDeleted             Boolean             @default(false) @map("is_deleted")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  // Relations
  manufacturingOrder    ManufacturingOrder  @relation(fields: [moId], references: [id], onDelete: Cascade)
  mbomDetail            MBOMDetail?         @relation(fields: [mbomDetailId], references: [id], onDelete: SetNull)
  uom                   Uom?                @relation(fields: [uomCode], references: [uomCode], onDelete: SetNull)
  dies                  Dies?               @relation(fields: [diesId], references: [id], onDelete: SetNull)
  diesUsage             DiesUsage?          @relation(fields: [diesUsageId], references: [id], onDelete: SetNull)
  machine               Machine?            @relation(fields: [machineId], references: [id], onDelete: SetNull)
  process               Process?            @relation(fields: [processId], references: [id], onDelete: SetNull)
  productionLogs        ProductionLog[]
  downtimeLogs          DowntimeLog[]
  qualityInspections    QualityInspection[]
  materialIssues        MaterialIssue[]
  wipEntries            WIPEntry[]

  @@index([woNumber])
  @@index([moId])
  @@index([mbomDetailId])
  @@index([diesId])
  @@index([machineId])
  @@index([processId])
  @@index([outputPartCode])
  @@index([uomCode])
  @@index([sequence])
  @@index([isReworkOrder])
  @@index([reworkSourceType])
  @@index([reworkReferenceNumber])
  @@index([shift])
  @@index([plannedDate])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_work_order")
}

// ============================================
// PRODUCTION - DAILY PRODUCTION SCHEDULE
// ============================================

model DailyProductionSchedule {
  id             String   @id @default(uuid())
  scheduleNumber String   @unique @map("schedule_number")
  scheduleDate   DateTime @map("schedule_date")
  shift          String
  moId           String?  @map("mo_id")
  moNumber       String?  @map("mo_number")
  woId           String?  @map("wo_id")
  woNumber       String?  @map("wo_number")
  partId         String?  @map("part_id")
  partCode       String?  @map("part_code")
  processId      String?  @map("process_id")
  machineId      String?  @map("machine_id")
  plannedQty     Float    @map("planned_qty")
  actualQty      Float    @default(0) @map("actual_qty")
  uomCode        String?  @map("uom_code")
  operatorName   String?  @map("operator_name")
  sequence       Int      @default(0)
  status         String   @default("Draft") // Draft, Released, In Progress, Completed, Cancelled
  notes          String?
  createdBy      String?  @map("created_by")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  productionLogs ProductionLog[]

  @@index([scheduleNumber])
  @@index([scheduleDate])
  @@index([shift])
  @@index([moId])
  @@index([moNumber])
  @@index([woId])
  @@index([woNumber])
  @@index([partId])
  @@index([partCode])
  @@index([processId])
  @@index([machineId])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_daily_production_schedule")
}

// ============================================
// PRODUCTION - PRODUCTION LOG (Log Produksi Per Shift)
// ============================================

model ProductionLog {
  id             String    @id @default(uuid())
  logNumber      String    @unique @map("log_number") // LOG-YYYYMMDD-001
  logDate        DateTime  @default(now()) @map("log_date")
  dpsId          String?   @map("dps_id")
  moId           String    @map("mo_id")
  woId           String?   @map("wo_id")
  shift          String // 1A, 1B, 2A, 2B, 3A, 3C
  machineCode    String?   @map("machine_code")
  operatorName   String    @map("operator_name")
  qtyPlanned     Float     @default(0) @map("qty_planned")
  qtyProduced    Float     @default(0) @map("qty_produced")
  qtyGood        Float     @default(0) @map("qty_good")
  qtyReject      Float     @default(0) @map("qty_reject")
  qtyRework      Float     @default(0) @map("qty_rework")
  startTime      DateTime? @map("start_time")
  endTime        DateTime? @map("end_time")
  runningMinutes Float?    @map("running_minutes")
  downtime       Float? // dalam menit
  downtimeReason String?   @map("downtime_reason")
  source         String?
  hmiTopic       String?   @map("hmi_topic")
  // Status: Open = masih berjalan, Submitted = diajukan, Approved = disetujui
  status         String    @default("Open")
  notes          String?
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  dailyProductionSchedule DailyProductionSchedule? @relation(fields: [dpsId], references: [id], onDelete: SetNull)
  manufacturingOrder      ManufacturingOrder       @relation(fields: [moId], references: [id], onDelete: Cascade)
  workOrder               WorkOrder?               @relation(fields: [woId], references: [id], onDelete: SetNull)
  downtimeLogs            DowntimeLog[]
  qualityInspections      QualityInspection[]

  @@index([logNumber])
  @@index([dpsId])
  @@index([moId])
  @@index([woId])
  @@index([logDate])
  @@index([shift])
  @@index([machineCode])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_production_log")
}

// ============================================
// PRODUCTION - DOWNTIME LOG
// ============================================

model DowntimeLog {
  id              String    @id @default(uuid())
  downtimeNumber  String    @unique @map("downtime_number") // DT-YYYYMMDD-001
  downtimeDate    DateTime  @default(now()) @map("downtime_date")
  moId            String    @map("mo_id")
  woId            String?   @map("wo_id")
  productionLogId String?   @map("production_log_id")
  shift           String? // 1A, 1B, 2A, 2B, 3A, 3C
  machineCode     String?   @map("machine_code")
  operatorName    String?   @map("operator_name")
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  durationMinutes Float     @default(0) @map("duration_minutes")
  reason          String
  category        String?
  status          String    @default("Open")
  notes           String?
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  manufacturingOrder ManufacturingOrder @relation(fields: [moId], references: [id], onDelete: Cascade)
  workOrder          WorkOrder?         @relation(fields: [woId], references: [id], onDelete: SetNull)
  productionLog      ProductionLog?     @relation(fields: [productionLogId], references: [id], onDelete: SetNull)

  @@index([downtimeNumber])
  @@index([downtimeDate])
  @@index([moId])
  @@index([woId])
  @@index([productionLogId])
  @@index([shift])
  @@index([machineCode])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_downtime_log")
}

// ============================================
// PRODUCTION - QUALITY INSPECTION (Header)
// ============================================

model QualityInspection {
  id                   String    @id @default(uuid())
  inspectionNumber     String    @unique @map("inspection_number") // QC-YYYYMMDD-001
  inspectionDate       DateTime  @default(now()) @map("inspection_date")
  moId                 String    @map("mo_id")
  woId                 String?   @map("wo_id")
  productionLogId      String?   @map("production_log_id")
  vendorProcessOrderId String?   @map("vendor_process_order_id")
  partId               String?   @map("part_id")
  batchNumber          String?   @map("batch_number")
  sampleSize           Int       @default(1) @map("sample_size")
  qtyInspected         Float     @default(0) @map("qty_inspected")
  qtyPassed            Float     @default(0) @map("qty_passed")
  qtyFailed            Float     @default(0) @map("qty_failed")
  qtyRework            Float     @default(0) @map("qty_rework")
  // Pending / Accepted / Rejected / Conditional Accept / Rework
  decision             String    @default("Pending")
  inspectedBy          String    @map("inspected_by")
  approvedBy           String?   @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  // Draft / Completed
  status               String    @default("Draft")
  notes                String?
  isDeleted            Boolean   @default(false) @map("is_deleted")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  manufacturingOrder ManufacturingOrder        @relation(fields: [moId], references: [id], onDelete: Cascade)
  workOrder          WorkOrder?                @relation(fields: [woId], references: [id], onDelete: SetNull)
  productionLog      ProductionLog?            @relation(fields: [productionLogId], references: [id], onDelete: SetNull)
  vendorProcessOrder VendorProcessOrder?       @relation(fields: [vendorProcessOrderId], references: [id], onDelete: SetNull)
  part               Part?                     @relation(fields: [partId], references: [id], onDelete: SetNull)
  details            QualityInspectionDetail[]

  @@index([inspectionNumber])
  @@index([moId])
  @@index([woId])
  @@index([productionLogId])
  @@index([vendorProcessOrderId])
  @@index([partId])
  @@index([decision])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_quality_inspection")
}

// ============================================
// PRODUCTION - QUALITY INSPECTION DETAIL (Parameter per Inspeksi)
// ============================================

model QualityInspectionDetail {
  id            String   @id @default(uuid())
  inspectionId  String   @map("inspection_id")
  lineNumber    Int      @map("line_number")
  // Nama parameter: Dimensi, Visual, Kekerasan, Berat, dll
  parameterName String   @map("parameter_name")
  standard      String? // Nilai standar / spec
  actualValue   String?  @map("actual_value")
  unit          String? // mm, kg, HRC, dll
  isPass        Boolean  @default(true) @map("is_pass")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([isPass])
  @@map("tbl_quality_inspection_detail")
}

// ============================================
// PRODUCTION - MATERIAL ISSUE (Pengeluaran Material ke Lantai Produksi)
// ============================================

model MaterialIssue {
  id            String   @id @default(uuid())
  issueNumber   String   @unique @map("issue_number") // MI-YYYYMMDD-001
  issueDate     DateTime @default(now()) @map("issue_date")
  moId          String   @map("mo_id")
  woId          String?  @map("wo_id")
  warehouseCode String   @map("warehouse_code")
  issuedBy      String?  @map("issued_by")
  receivedBy    String?  @map("received_by")
  // Draft / Issued / Partially Returned / Closed
  status        String   @default("Draft")
  notes         String?
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  manufacturingOrder ManufacturingOrder    @relation(fields: [moId], references: [id], onDelete: Cascade)
  workOrder          WorkOrder?            @relation(fields: [woId], references: [id], onDelete: SetNull)
  warehouse          Warehouse             @relation(fields: [warehouseCode], references: [warehouseCode])
  details            MaterialIssueDetail[]

  @@index([issueNumber])
  @@index([moId])
  @@index([woId])
  @@index([warehouseCode])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_material_issue")
}

// ============================================
// PRODUCTION - MATERIAL ISSUE DETAIL (Item per Pengeluaran Material)
// ============================================

model MaterialIssueDetail {
  id                String   @id @default(uuid())
  issueId           String   @map("issue_id")
  lineNumber        Int      @map("line_number")
  partCode          String?  @map("part_code") // Part / material code
  partNumber        String?  @map("part_number")
  partName          String?  @map("part_name")
  spec              String?
  thickness         Float?
  width             Float?
  CSP               String?  @map("CSP")
  productId         String?  @map("product_id") // Consumable product
  description       String? // Deskripsi item bebas
  stockBalanceId    String?  @map("stock_balance_id")
  requirementSource String?  @map("requirement_source")
  isSubAssembly     Boolean  @default(false) @map("is_sub_assembly")
  rackCode          String?  @map("rack_code")
  qtyRequired       Float    @map("qty_required") // Qty sesuai kebutuhan produksi
  qtyIssued         Float    @default(0) @map("qty_issued") // Qty yang benar-benar dikeluarkan
  qtyReturned       Float    @default(0) @map("qty_returned") // Qty yang dikembalikan
  uomCode           String?  @map("uom_code")
  lotNumber         String?  @map("lot_number")
  notes             String?
  isDeleted         Boolean  @default(false) @map("is_deleted")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  materialIssue MaterialIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([partCode])
  @@index([partNumber])
  @@index([partName])
  @@index([spec])
  @@index([thickness])
  @@index([width])
  @@index([CSP])
  @@index([productId])
  @@index([stockBalanceId])
  @@index([requirementSource])
  @@index([isSubAssembly])
  @@index([rackCode])
  @@index([lotNumber])
  @@index([isDeleted])
  @@map("tbl_material_issue_detail")
}

// ============================================
// PRODUCTION - WIP ENTRY (Work In Progress Ledger)
// ============================================

model WIPEntry {
  id            String   @id @default(uuid())
  entryNumber   String   @unique @map("entry_number") // WIP-YYYYMMDD-0001
  entryDate     DateTime @default(now()) @map("entry_date")
  moId          String   @map("mo_id")
  woId          String?  @map("wo_id")
  // Tipe biaya: Material, Labor, Overhead, Scrap
  costType      String   @map("cost_type") // Material | Labor | Overhead | Scrap
  // Sumber transaksi
  sourceType    String   @map("source_type") // MaterialIssue | WorkOrder | ProductionLog | QualityInspection | Manual
  sourceId      String?  @map("source_id") // ID dokumen sumber
  sourceRef     String?  @map("source_ref") // Nomor dokumen sumber (MI-xxx, WO-xxx)
  partCode      String?  @map("part_code")
  partNumber    String?  @map("part_number")
  partName      String?  @map("part_name")
  uomCode       String?  @map("uom_code")
  warehouseCode String?  @map("warehouse_code")
  rackCode      String?  @map("rack_code")
  lotNumber     String?  @map("lot_number")
  stockType     String?  @map("stock_type")
  // Nilai
  qty           Float    @default(0)
  rate          Float    @default(0) // Biaya per unit
  amount        Float    @default(0) // qty × rate (atau manual)
  // Direction: IN = akumulasi WIP, OUT = transfer keluar WIP (FG receipt, scrap)
  direction     String   @default("IN") // IN | OUT
  notes         String?
  createdBy     String?  @map("created_by")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  manufacturingOrder ManufacturingOrder @relation(fields: [moId], references: [id], onDelete: Cascade)
  workOrder          WorkOrder?         @relation(fields: [woId], references: [id], onDelete: SetNull)

  @@index([entryNumber])
  @@index([moId])
  @@index([woId])
  @@index([costType])
  @@index([sourceType])
  @@index([partCode])
  @@index([partNumber])
  @@index([direction])
  @@index([entryDate])
  @@index([isDeleted])
  @@map("tbl_wip_entry")
}

// ============================================
// SYSTEM - NOTIFICATIONS
// ============================================

model Notification {
  id        String    @id @default(uuid())
  type      String // "purchase_order", "sales_order", "bom", "production", dll
  title     String // "Purchase Order Baru", "SO#12345 Diupdate", dll
  message   String // Detail message
  entityId  String?   @map("entity_id") // ID/identifier dari entity terkait (poNumber, soNumber, dll)
  entityUrl String?   @map("entity_url") // Deep link ke detail page
  userId    String?   @map("user_id") // Target user (null = broadcast ke semua)
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  metadata  Json?     @default("{}") // Additional data (priority, sender, etc)
  createdBy String?   @map("created_by") // User yang trigger notification
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("tbl_notifications")
}
