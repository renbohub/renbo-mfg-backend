  sourceDeliveryTargetId    String?   @map("source_delivery_target_id")
  sourceType                String?   @map("source_type")
  sourceNumber              String?   @map("source_number")
  sourceLineId              String?   @map("source_line_id")
  phaseNumber               Int?      @map("phase_number")
  customerCode              String?   @map("customer_code")
  partCode                  String    @map("part_code")
  partNumber                String?   @map("part_number")
  partName                  String?   @map("part_name")
  demandQty                 Float     @default(0) @map("demand_qty")
  uomCode                   String?   @map("uom_code")
  targetDeliveryDate        DateTime? @map("target_delivery_date")
  productionLatestStartDate DateTime? @map("production_latest_start_date")
  exceptionType             String    @map("exception_type")
  severity                  String
  priority                  String    @default("P2")
  title                     String
  description               String
  status                    String    @default("OPEN")
  sourceActive              Boolean   @default(true) @map("source_active")
  sourceClearedAt           DateTime? @map("source_cleared_at")
  ownerUserId               String?   @map("owner_user_id")
  ownerUsername             String?   @map("owner_username")
  ownerName                 String?   @map("owner_name")
  targetResolutionDate      DateTime? @map("target_resolution_date")
  detectedAt                DateTime  @default(now()) @map("detected_at")
  lastDetectedAt            DateTime  @default(now()) @map("last_detected_at")
  acknowledgedBy            String?   @map("acknowledged_by")
  acknowledgedAt            DateTime? @map("acknowledged_at")
  resolvedBy                String?   @map("resolved_by")
  resolvedAt                DateTime? @map("resolved_at")
  resolutionSummary         String?   @map("resolution_summary")
