// ============================================
// PRODUCTION - MBOM DETAIL
// ============================================

model MBOMDetail {
  id                      String   @id @default(uuid())
  noReg                   String   @map("no_reg")
  parentDetailId          String?  @map("parent_detail_id")
  levelComponent          Int      @default(0) @map("level_component")
  partId                  String?  @map("part_id")
  qty                     Float    @default(0)
  uomCode                 String?  @map("uom_code")
  category                Category @default(Purchase) // inHouse, Purchase, Vendor
  assemblyPolicyOverride  String   @default("DEFAULT") @map("assembly_policy_override") // DEFAULT, INLINE, SUB_ASSEMBLY
  scrapFactor             Float    @default(0) @map("scrap_factor") // Auto-calculated dari PartBase (baseOn='Actual'): (scrapWeight/grossWeight)*100
  materialThickness       Float?   @map("material_thickness") // Snapshot T (mm) dari Master Material
  materialWidth           Float?   @map("material_width") // Snapshot W (mm) dari Master Material
  materialPitch           Float?   @map("material_pitch") // P/pitch pemakaian material (mm)
  materialCavity          Int?     @map("material_cavity") // Output part per pitch/shot
  materialDensity         Float?   @map("material_density") // Snapshot density (kg/mm3), contoh baja 0.00000785
  grossWeight             Float    @default(0) @map("gross_weight") // kg per pcs = T*W*P*density/cavity
  defaultGrossWeight      Float?   @map("default_gross_weight")
  materialFormId          String?  @map("material_form_id")
  materialScheme          String   @default("DEFAULT") @map("material_scheme") // DEFAULT or ALTERNATIVE, dipakai MRP
  alternateMaterialFormId String?  @map("alternate_material_form_id")
  alternateMaterialPitch  Float?   @map("alternate_material_pitch")
  alternateMaterialCavity Int?     @map("alternate_material_cavity")
  alternateGrossWeight    Float?   @map("alternate_gross_weight")
  leadTime                Float    @default(0) @map("lead_time") // Nilai lead time sesuai leadTimeUnit; tidak dikalikan quantity
  leadTimeUnit            String   @default("HOUR") @map("lead_time_unit") // SECOND, MINUTE, HOUR, DAY (1 hari kerja = 8 jam)
  createdBy               String?  @map("created_by")
  notes                   String?
  isDeleted               Boolean  @default(false) @map("is_deleted")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  mbomHeader            MBOMHeader       @relation(fields: [noReg], references: [noReg], onDelete: Cascade)
  parentDetail          MBOMDetail?      @relation("MBOMDetailTree", fields: [parentDetailId], references: [id], onDelete: SetNull)
  children              MBOMDetail[]     @relation("MBOMDetailTree")
  mbomProcesses         MBOMProcess[]
  workOrders            WorkOrder[]
  part                  Part?            @relation(fields: [partId], references: [id], onDelete: SetNull)
  uom                   Uom?             @relation(fields: [uomCode], references: [uomCode], onDelete: SetNull)
  mbomcostDetails       MBOMCostDetail[]
  mrpRequirements       MRPRequirement[]
  materialForm          MaterialForm?    @relation("MBOMDefaultMaterialForm", fields: [materialFormId], references: [id], onDelete: SetNull)
  alternateMaterialForm MaterialForm?    @relation("MBOMAlternateMaterialForm", fields: [alternateMaterialFormId], references: [id], onDelete: SetNull)

  @@index([noReg])
  @@index([parentDetailId])
  @@index([partId])
  @@index([uomCode])
  @@index([category])
  @@index([assemblyPolicyOverride])
  @@index([materialFormId])
  @@index([alternateMaterialFormId])
  @@index([isDeleted])
