// ============================================
// PURCHASING - PURCHASE INVOICE PAYMENT
// ============================================

model PurchaseInvoicePayment {
  id                 String    @id @default(uuid())
  invoiceNumber      String    @map("invoice_number")
  lineNumber         Int       @map("line_number")
  paymentPlan        String?   @map("payment_plan")
  plannedPaymentDate DateTime? @map("planned_payment_date")
  actualPaymentDate  DateTime? @map("actual_payment_date")
  amountPayment      Float     @default(0) @map("amount_payment")
  outstandingPayment Float     @default(0) @map("outstanding_payment")
  notes              String?
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  invoice PurchaseInvoice @relation(fields: [invoiceNumber], references: [invoiceNumber], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([actualPaymentDate])
  @@index([plannedPaymentDate])
  @@map("tbl_purchase_invoice_payment")
}

// ============================================
// PURCHASING - INCOMING INSPECTION
// ============================================

model IncomingInspection {
  id               String    @id @default(uuid())
  inspectionNumber String    @unique @map("inspection_number")
  inspectionDate   DateTime  @default(now()) @map("inspection_date")
  grNumber         String    @map("gr_number")
  status           String    @default("Open") // Open, In Progress, Completed, Cancelled
  decision         String    @default("Pending") // Pending, Accepted, Partially Accepted, Rejected, QC Bypassed
  inspectedBy      String?   @map("inspected_by")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  notes            String?
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  gr      GoodsReceipt               @relation(fields: [grNumber], references: [grNumber], onDelete: Cascade)
  details IncomingInspectionDetail[]

  @@index([inspectionNumber])
  @@index([grNumber])
  @@index([status])
  @@index([decision])
  @@index([isDeleted])
  @@map("tbl_incoming_inspection")
}

model IncomingInspectionDetail {
  id                   String    @id @default(uuid())
  inspectionId         String    @map("inspection_id")
  grDetailId           String    @map("gr_detail_id")
  lineNumber           Int       @map("line_number")
  qtyInspected         Float     @default(0) @map("qty_inspected")
  qtyAccepted          Float     @default(0) @map("qty_accepted")
  qtyRejected          Float     @default(0) @map("qty_rejected")
  qtyRework            Float     @default(0) @map("qty_rework")
  qtyAcceptedPutaway   Float     @default(0) @map("qty_accepted_putaway")
  qtyRejectedDisposed  Float     @default(0) @map("qty_rejected_disposed")
  disposition          String?
  rejectedDisposition  String?   @map("rejected_disposition")
  dispositionReference String?   @map("disposition_reference")
  disposedBy           String?   @map("disposed_by")
  disposedAt           DateTime? @map("disposed_at")
  defectCode           String?   @map("defect_code")
  defectCategory       String?   @map("defect_category")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  inspection IncomingInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  grDetail   GoodsReceiptDetail @relation(fields: [grDetailId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([grDetailId])
  @@map("tbl_incoming_inspection_detail")
}

// ============================================
// PRODUCTION - MANUFACTURING ORDER
// ============================================

model ManufacturingOrder {
  id                                    String                        @id @default(uuid())
  moNumber                              String                        @unique @map("mo_number") // MO-YYYYMMDD-001
  moDate                                DateTime                      @default(now()) @map("mo_date")
  // Reference sumber
  referenceType                         String?                       @map("reference_type") // Internal, MRPPlannedOrder
  plannedOrderNumber                    String?                       @map("planned_order_number") // FK ke PlannedOrder.orderNumber (jika referenceType = MRPPlannedOrder)
  monthlyProductionPlanNumber           String?                       @map("monthly_production_plan_number")
  monthlyProductionPlanLineNumber       Int?                          @map("monthly_production_plan_line_number")
  // Part yang diproduksi
  partId                                String?                       @map("part_id")
  // Qty
  qtyPlanned                            Float                         @map("qty_planned")
  uomCode                               String?                       @map("uom_code")
  materialRequirementUomMode            String                        @default("kg") @map("material_requirement_uom_mode") // kg, ORIGINAL, BY_ITEM_TYPE
  qtyProduced                           Float                         @default(0) @map("qty_produced")
  qtyGood                               Float                         @default(0) @map("qty_good")
  qtyReject                             Float                         @default(0) @map("qty_reject")
