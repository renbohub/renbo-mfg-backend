// ============================================
// PLANNING - FORECAST
// ============================================

model Forecast {
  id             String    @id @default(uuid())
  forecastNumber String    @unique @map("forecast_number")
  forecastName   String?   @map("forecast_name")
  periodStart    DateTime  @map("period_start") // Base period start
  periodEnd      DateTime  @map("period_end") // Base period end
  customerCode   String?   @map("customer_code") // Optional: forecast per customer
  status         String    @default("Draft") // Draft, Confirmed, Obsolete
  notes          String?
  createdBy      String?   @map("created_by")
  approvedBy     String?   @map("approved_by")
  approvedDate   DateTime? @map("approved_date")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  details ForecastDetail[]

  @@index([forecastNumber])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([customerCode])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_forecast")
}

// ============================================
// PLANNING - FORECAST DETAIL
// ============================================

model ForecastDetail {
  id             String  @id @default(uuid())
  forecastNumber String  @map("forecast_number")
  lineNumber     Int     @map("line_number")
  partCode       String  @map("part_code")
  partId         String? @map("part_id")
  uomCode        String? @map("uom_code")

  // M+1 Period (Base month + 1)
  M1Forecast DateTime? @map("m1_forecast") // Tanggal forecast M+1
  M1Qty      Float     @default(0) @map("m1_qty") // Forecast qty untuk M+1

  // M+2 Period (Base month + 2)
  M2Forecast DateTime? @map("m2_forecast") // Tanggal forecast M+2
  M2Qty      Float     @default(0) @map("m2_qty")

  // M+3 Period (Base month + 3)
  M3Forecast DateTime? @map("m3_forecast") // Tanggal forecast M+3
  M3Qty      Float     @default(0) @map("m3_qty")

  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  forecast   Forecast    @relation(fields: [forecastNumber], references: [forecastNumber], onDelete: Cascade)
  part       Part?       @relation(fields: [partId], references: [id], onDelete: SetNull)
  mpsDetails MPSDetail[]

  @@index([forecastNumber])
  @@index([partCode])
  @@index([partId])
  @@index([uomCode])
  @@index([isDeleted])
  @@map("tbl_forecast_detail")
}

// ============================================
// PLANNING - MPS (Master Production Schedule)
// ============================================

model MPS {
  id             String    @id @default(uuid())
  mpsNumber      String    @unique @map("mps_number")
  mpsName        String?   @map("mps_name")
  periodStart    DateTime  @map("period_start") // Planning period start
  periodEnd      DateTime  @map("period_end") // Planning period end
  forecastNumber String?   @map("forecast_number") // Reference ke Demand Forecast
  status         String    @default("Draft") // Draft, Confirmed, Released, Completed
  notes          String?
  createdBy      String?   @map("created_by")
  approvedBy     String?   @map("approved_by")
  approvedDate   DateTime? @map("approved_date")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  details MPSDetail[]
  mrpRuns MRPRun[]

  @@index([mpsNumber])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([forecastNumber])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_mps")
}

// ============================================
// PLANNING - MPS DETAIL
// ============================================

model MPSDetail {
  id                   String   @id @default(uuid())
  mpsNumber            String   @map("mps_number")
  lineNumber           Int      @map("line_number")
  partCode             String   @map("part_code")
  partId               String?  @map("part_id")
  mbomHeaderId         String?  @map("mbom_header_id")
  forecastQty          Float    @default(0) @map("forecast_qty") // Forecast bulan berjalan sebelum buffer
  actualSalesOrderQty  Float    @default(0) @map("actual_sales_order_qty") // SO aktual pada bucket yang sama
  bufferBaseQty        Float    @default(0) @map("buffer_base_qty") // Forecast part pada bulan berikutnya
  bufferPercent        Float    @default(0) @map("buffer_percent")
  bufferQty            Float    @default(0) @map("buffer_qty")
  bufferOverridden     Boolean  @default(false) @map("buffer_overridden")
  bufferReferenceScope String   @default("PARENT_FG") @map("buffer_reference_scope")
  effectiveDemandQty   Float    @default(0) @map("effective_demand_qty") // Forecast + buffer, minimum akan dinet terhadap SO di MRP
  productionPercent    Float    @default(100) @map("production_percent")
  productionOverridden Boolean  @default(false) @map("production_overridden")
  qtyPlanned           Float    @map("qty_planned") // Target MPS = max((forecast + buffer) x production %, SO aktual)
  startDate            DateTime @map("start_date")
  endDate              DateTime @map("end_date")
  priority             Int      @default(1) // Priority level
  status               String   @default("Planned") // Planned, In Progress, Completed, Cancelled
  soNumber             String?  @map("so_number") // Reference jika dari SO
  customerCode         String?  @map("customer_code")
  // Traceability: dari forecast mana row ini berasal
  forecastDetailId     String?  @map("forecast_detail_id") // FK ke ForecastDetail
  forecastPeriodOffset Int?     @map("forecast_period_offset") // 1=M1, 2=M2, 3=M3 (dari forecast mana)
  notes                String?
  isDeleted            Boolean  @default(false) @map("is_deleted")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  mps             MPS              @relation(fields: [mpsNumber], references: [mpsNumber], onDelete: Cascade)
  mbom            MBOMHeader?      @relation(fields: [mbomHeaderId], references: [id])
  part            Part?            @relation(fields: [partId], references: [id], onDelete: SetNull)
  forecastDetail  ForecastDetail?  @relation(fields: [forecastDetailId], references: [id], onDelete: SetNull)
  mrpRequirements MRPRequirement[]

  @@index([mpsNumber])
  @@index([partCode])
  @@index([partId])
  @@index([mbomHeaderId])
  @@index([startDate])
  @@index([endDate])
  @@index([priority])
  @@index([status])
  @@index([soNumber])
  @@index([customerCode])
  @@index([forecastDetailId])
  @@index([isDeleted])
  @@map("tbl_mps_detail")
}

// ============================================
// PLANNING - MRP RUN (MRP Execution Header)
// ============================================

model MRPRun {
  id                    String   @id @default(uuid())
  runNumber             String   @unique @map("run_number")
  planNumber            String?  @map("plan_number")
  planRevision          Int      @default(1) @map("plan_revision")
  planScope             String?  @map("plan_scope") // MPS, SO, Manual
  isCurrentPlan         Boolean  @default(true) @map("is_current_plan")
  runDate               DateTime @default(now()) @map("run_date")
  mpsNumber             String?  @map("mps_number") // Reference ke MPS
  planHorizon           Int      @default(90) @map("plan_horizon") // Planning horizon in days
  cutoffDate            DateTime @map("cutoff_date") // Cut-off date untuk calculation
  status                String   @default("Running") // Running, Completed, Failed
  totalRequirements     Int      @default(0) @map("total_requirements") // Total requirement lines generated
  totalPlannedOrders    Int      @default(0) @map("total_planned_orders") // Total planned orders
  soDemandConsumedQty   Float    @default(0) @map("so_demand_consumed_qty")
  soDemandImpactedLines Int      @default(0) @map("so_demand_impacted_lines")
  nettingSummary        Json?    @map("netting_summary")
  executionTime         Int?     @map("execution_time") // Execution time in seconds
  errorMessage          String?  @map("error_message")
  notes                 String?
  runBy                 String?  @map("run_by")
  isDeleted             Boolean  @default(false) @map("is_deleted")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  mps           MPS?             @relation(fields: [mpsNumber], references: [mpsNumber])
  requirements  MRPRequirement[]
  plannedOrders PlannedOrder[]

  @@index([runNumber])
  @@index([planNumber])
  @@index([planNumber, planRevision])
  @@index([isCurrentPlan])
  @@index([runDate])
  @@index([mpsNumber])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_mrp_run")
}

// ============================================
// PLANNING - MRP REQUIREMENT
// ============================================

model MRPRequirement {
  id                   String    @id @default(uuid())
  runNumber            String    @map("run_number")
  parentRequirementId  String?   @map("parent_requirement_id")
  rootRequirementId    String?   @map("root_requirement_id")
  treePath             String?   @map("tree_path")
  levelMBOM            Int       @default(0) @map("level_mbom") // BOM level (0=FG, 1=sub-assy, 2=component)
  mbomLevelComponent   Int?      @map("mbom_level_component")
  mbomDetailId         String?   @map("mbom_detail_id")
  partCode             String    @map("part_code")
  partId               String?   @map("part_id")
  requirementType      String    @map("requirement_type") // Independent (dari MPS), Dependent (dari BOM explosion)
  sourceType           String?   @map("source_type") // MPS, SO, FORECAST
  sourceNumber         String?   @map("source_number")
  mpsDetailId          String?   @map("mps_detail_id") // FK ke MPSDetail untuk traceability MPS → MRP
  requiredDate         DateTime  @map("required_date")
  grossRequirement     Float     @map("gross_requirement") // Total requirement
  forecastQty          Float     @default(0) @map("forecast_qty")
  soConsumedQty        Float     @default(0) @map("so_consumed_qty")
  effectiveDemandQty   Float     @default(0) @map("effective_demand_qty")
  bufferBaseQty        Float     @default(0) @map("buffer_base_qty") // Demand purchase part pada bulan A+1
  bufferPercent        Float     @default(0) @map("buffer_percent") // Default master Part, dapat dioverride per bucket MRP
  bufferQty            Float     @default(0) @map("buffer_qty") // bufferBaseQty * bufferPercent / 100
  bufferOverridden     Boolean   @default(false) @map("buffer_overridden")
  bufferReferenceScope String    @default("PARENT_FG") @map("buffer_reference_scope")
  consumptionSources   Json?     @map("consumption_sources")
  onHandQty            Float     @default(0) @map("on_hand_qty") // Stock tersedia
  allocatedQty         Float     @default(0) @map("allocated_qty") // Reserved stock
  netRequirement       Float     @map("net_requirement") // Gross - OnHand - Allocated
  plannedOrderQty      Float     @default(0) @map("planned_order_qty") // Qty planned order
  orderPercent         Float     @default(100) @map("order_percent") // Override PPIC atas forecast; SO tetap minimum
  adjustedOrderQty     Float     @default(0) @map("adjusted_order_qty") // Qty setelah Order % dan netting stock
  orderType            String?   @map("order_type") // Purchase, Production
  leadTime             Int       @default(0) @map("lead_time") // Lead time in days
  orderDate            DateTime? @map("order_date") // Calculated order date
  notes                String?
  isDeleted            Boolean   @default(false) @map("is_deleted")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  mrpRun            MRPRun           @relation(fields: [runNumber], references: [runNumber], onDelete: Cascade)
  parentRequirement MRPRequirement?  @relation("MRPRequirementTree", fields: [parentRequirementId], references: [id], onDelete: SetNull)
  children          MRPRequirement[] @relation("MRPRequirementTree")
  part              Part?            @relation(fields: [partId], references: [id], onDelete: SetNull)
  mpsDetail         MPSDetail?       @relation(fields: [mpsDetailId], references: [id], onDelete: SetNull)
  mbomDetail        MBOMDetail?      @relation(fields: [mbomDetailId], references: [id], onDelete: SetNull)

  @@index([runNumber])
  @@index([parentRequirementId])
  @@index([rootRequirementId])
  @@index([treePath])
  @@index([levelMBOM])
  @@index([mbomLevelComponent])
  @@index([mbomDetailId])
  @@index([partCode])
  @@index([partId])
  @@index([requirementType])
  @@index([sourceType])
  @@index([sourceNumber])
  @@index([mpsDetailId])
  @@index([requiredDate])
  @@index([orderType])
  @@index([isDeleted])
  @@map("tbl_mrp_requirement")
}

// ============================================
// PLANNING - PLANNED ORDER
// ============================================

model PlannedOrder {
  id                     String   @id @default(uuid())
  orderNumber            String   @unique @map("order_number")
  runNumber              String?  @map("run_number") // Nullable: SO-driven planned order tidak punya runNumber
  orderType              String   @map("order_type") // Purchase, Production
  partCode               String   @map("part_code")
  partId                 String?  @map("part_id")
  qty                    Float
  uomCode                String?  @map("uom_code")
  requiredDate           DateTime @map("required_date")
  orderDate              DateTime @map("order_date") // Planned order date (required - lead time)
  supplierCode           String?  @map("supplier_code") // Untuk purchase orders
  supplierProposalSource String?  @map("supplier_proposal_source") // PART_MASTER atau PPIC
  lotCount               Float?   @map("lot_count") // Jumlah lot yang dibeli (khusus raw material)
  kgPerLot               Float?   @map("kg_per_lot") // Berat aktual yang dipilih PPIC untuk setiap lot
  purchaseQtyKg          Float?   @map("purchase_qty_kg") // purchaseLotQty * kgPerLot
  lotAllocations         Json?    @map("lot_allocations") // Alokasi satu lot ke beberapa child part/FG/source demand
  vendorCode             String?  @map("vendor_code") // Untuk vendor orders
  mbomHeaderId           String?  @map("mbom_header_id") // Untuk manufacturing orders
  referenceType          String?  @map("reference_type") // SO, MRP, dll
  referenceNumber        String?  @map("reference_number") // soNumber#lineNumber atau mrpRunNumber
  status                 String   @default("Planned") // Planned, Monthly Planned, Partially Released, Released, Covered, Cancelled
  priority               Int      @default(1)
  notes                  String?
  isDeleted              Boolean  @default(false) @map("is_deleted")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  mrpRun MRPRun? @relation(fields: [runNumber], references: [runNumber], onDelete: Cascade)
  part   Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([orderNumber])
  @@index([runNumber])
  @@index([orderType])
  @@index([partCode])
  @@index([partId])
  @@index([requiredDate])
  @@index([orderDate])
  @@index([supplierCode])
  @@index([supplierProposalSource])
  @@index([vendorCode])
  @@index([mbomHeaderId])
  @@index([referenceType])
  @@index([referenceNumber])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_planned_order")
}

// ============================================
// PLANNING - MONTHLY PRODUCTION PLAN
// ============================================

model MonthlyProductionPlan {
  id                       String    @id @default(uuid())
  planNumber               String    @unique @map("plan_number")
  planMonth                DateTime  @map("plan_month")
  periodStart              DateTime  @map("period_start")
  periodEnd                DateTime  @map("period_end")
  status                   String    @default("Draft") // Draft, Confirmed, Released, Closed, Cancelled
  sourceType               String    @default("PlannedOrder") @map("source_type")
  notes                    String?
  confirmedBy              String?   @map("confirmed_by")
  confirmedAt              DateTime? @map("confirmed_at")
  releasedBy               String?   @map("released_by")
  releasedAt               DateTime? @map("released_at")
  capacityOverrideApproved Boolean   @default(false) @map("capacity_override_approved")
  capacityOverrideReason   String?   @map("capacity_override_reason")
  capacityOverrideBy       String?   @map("capacity_override_by")
  capacityOverrideAt       DateTime? @map("capacity_override_at")
  closedBy                 String?   @map("closed_by")
  closedAt                 DateTime? @map("closed_at")
  createdBy                String?   @map("created_by")
  isDeleted                Boolean   @default(false) @map("is_deleted")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

