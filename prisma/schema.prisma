  findNumber          String?  @map("find_number") // Nomor referensi pada gambar teknik (drawing)
  referenceDesignator String?  @map("reference_designator") // e.g., R1, C2, U5
  createdBy           String?  @map("created_by")
  notes               String?
  isDeleted           Boolean  @default(false) @map("is_deleted")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  ebomHeader      EBOMHeader       @relation(fields: [noReg], references: [noReg], onDelete: Cascade)
  parentDetail    EBOMDetail?      @relation("EBOMDetailTree", fields: [parentDetailId], references: [id], onDelete: SetNull)
  children        EBOMDetail[]     @relation("EBOMDetailTree")
  ebomProcesses   EBOMProcess[]
  ebomcostDetails EBOMCostDetail[]
  part            Part?            @relation(fields: [partId], references: [id], onDelete: SetNull)
  uom             Uom?             @relation(fields: [uomCode], references: [uomCode], onDelete: SetNull)

  @@index([noReg])
  @@index([parentDetailId])
  @@index([partId])
  @@index([uomCode])
  @@index([category])
  @@index([levelComponent])
  @@index([isDeleted])
  @@map("tbl_ebomdetail")
}

// ============================================
// ENGINEERING - EBOM PROCESS
// ============================================

model EBOMProcess {
  id           String   @id @default(uuid())
  noReg        String   @map("no_reg")
  ebomDetailId String   @map("ebom_detail_id")
  parentId     String?  @map("parent_id") // NULL = proses utama, berisi ID = subprocess
  processId    String?  @map("process_id") // Diisi jika proses utama (parentId = null)
  subProcessId String?  @map("sub_process_id") // Diisi jika subprocess (parentId != null)
  sequence     Int      @default(0)
  cycleTime    Float    @default(0) @map("cycle_time")
  notes        String?
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  ebomDetail      EBOMDetail?      @relation(fields: [ebomDetailId], references: [id], onDelete: Cascade)
  ebomcostDetails EBOMCostDetail[]
  process         Process?         @relation(fields: [processId], references: [id])
  subProcess      SubProcess?      @relation(fields: [subProcessId], references: [id])
  parent          EBOMProcess?     @relation("EBOMSubprocess", fields: [parentId], references: [id], onDelete: Cascade)
  subprocesses    EBOMProcess[]    @relation("EBOMSubprocess")

  @@index([noReg])
  @@index([ebomDetailId])
  @@index([parentId])
  @@index([processId])
  @@index([subProcessId])
  @@index([sequence])
  @@index([isDeleted])
  @@map("tbl_ebomprocess")
}

