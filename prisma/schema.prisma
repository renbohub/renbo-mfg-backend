model Material {
  id                       String  @id @default(uuid())
  materialCode             String  @unique @map("material_code")
  materialName             String? @map("material_name")
  materialType             String? @map("material_type")
  itemCategory             String? @map("item_category")
  materialFamily           String? @map("material_family")
  materialForm             String? @map("material_form")
  materialGrade            String? @map("material_grade")
  attributeSet             String? @map("attribute_set")
  status                   String? @default("Draft")
  canTrackLot              Boolean @default(false) @map("can_track_lot")
  spec                     String?
  thickness                Float?
  width                    Float?
  CSP                      String? @map("CSP")
  density                  Float?  @map("density")
  materialSubstanceId      String? @map("material_substance_id")
  materialGradeId          String? @map("material_grade_id")
  materialFormId           String? @map("material_form_id")
  materialDensityId        String? @map("material_density_id")
  // Procurement conversion is material-specific. Example: 1 COIL = 2,500 KG
  // or 1 SHEET = 4 PCS. These values are defaults; transaction documents keep
  // their own snapshot so historical quantities never drift when the master changes.
  defaultPurchaseUomCode   String? @map("default_purchase_uom_code")
  defaultConversionUomCode String? @map("default_conversion_uom_code")
  defaultConversionFactor  Float?  @map("default_conversion_factor")

  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  materialSubstance  MaterialSubstance?       @relation(fields: [materialSubstanceId], references: [id], onDelete: SetNull)
  materialGradeRef   MaterialGrade?           @relation(fields: [materialGradeId], references: [id], onDelete: SetNull)
  materialFormRef    MaterialForm?            @relation(fields: [materialFormId], references: [id], onDelete: SetNull)
  materialDensityRef MaterialDensity?         @relation(fields: [materialDensityId], references: [id], onDelete: SetNull)
  materialPriceLists MaterialPriceList[]
  parts              Part[]
  attributeValues    MaterialAttributeValue[]
  lotMasters         LotMaster[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]

  @@index([materialCode])
  @@index([materialType])
  @@index([materialSubstanceId])
  @@index([materialGradeId])
  @@index([materialFormId])
  @@index([materialDensityId])
  @@index([materialFamily])
  @@index([materialForm])
  @@index([spec])
  @@index([thickness])
  @@index([width])
  @@index([CSP])
  @@index([isDeleted])
  @@map("tbl_material")
}

