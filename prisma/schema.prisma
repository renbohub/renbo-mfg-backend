// ============================================
// PLANNING - MPS DETAIL
// ============================================

model MPSDetail {
  id                      String    @id @default(uuid())
  mpsNumber               String    @map("mps_number")
  lineNumber              Int       @map("line_number")
  partCode                String    @map("part_code")
  partId                  String?   @map("part_id")
  mbomHeaderId            String?   @map("mbom_header_id")
  mbomSelectionMode       String    @default("AUTO_EFFECTIVE_DATE") @map("mbom_selection_mode")
  mbomSelectionDate       DateTime? @map("mbom_selection_date")
  mbomRevisionSnapshot    Int?      @map("mbom_revision_snapshot")
  mbomNoRegSnapshot       String?   @map("mbom_no_reg_snapshot")
  mbomSelectionWarning    String?   @map("mbom_selection_warning")
  forecastQty             Float     @default(0) @map("forecast_qty") // Forecast bulan berjalan sebelum buffer
  actualSalesOrderQty     Float     @default(0) @map("actual_sales_order_qty") // SO aktual pada bucket yang sama
  bufferBaseQty           Float     @default(0) @map("buffer_base_qty") // Forecast part pada bulan berikutnya
  bufferPercent           Float     @default(0) @map("buffer_percent")
  bufferQty               Float     @default(0) @map("buffer_qty")
  bufferOverridden        Boolean   @default(false) @map("buffer_overridden")
  bufferReferenceScope    String    @default("PARENT_FG") @map("buffer_reference_scope")
  effectiveDemandQty      Float     @default(0) @map("effective_demand_qty") // Forecast + buffer, minimum akan dinet terhadap SO di MRP
  productionPercent       Float     @default(100) @map("production_percent")
  productionOverridden    Boolean   @default(false) @map("production_overridden")
  demandPolicy            String    @default("MTO") @map("demand_policy") // MTO forecast is provisional; MTS keeps max(forecast, SO)
  openingAvailableQty     Float     @default(0) @map("opening_available_qty")
  firmScheduledReceiptQty Float     @default(0) @map("firm_scheduled_receipt_qty")
  targetEndingStockQty    Float     @default(0) @map("target_ending_stock_qty")
  projectedEndingStockQty Float     @default(0) @map("projected_ending_stock_qty")
  calculationTrace        Json?     @map("calculation_trace")
  qtyPlanned              Float     @map("qty_planned") // Net planned production after FG stock, firm receipts, and ending-stock target
  startDate               DateTime  @map("start_date")
  endDate                 DateTime  @map("end_date")
  priority                Int       @default(1) // Priority level
  status                  String    @default("Planned") // Planned, In Progress, Completed, Cancelled
  soNumber                String?   @map("so_number") // Reference jika dari SO
  customerCode            String?   @map("customer_code")
  deliveryPhaseId         String?   @map("delivery_phase_id")
  customerTargetDate      DateTime? @map("customer_target_date")
  fgRequiredDate          DateTime? @map("fg_required_date")
  priorityScore           Float?    @map("priority_score")
  priorityClass           String?   @map("priority_class")
  // Traceability: dari forecast mana row ini berasal
  forecastDetailId        String?   @map("forecast_detail_id") // FK ke ForecastDetail
  forecastPeriodOffset    Int?      @map("forecast_period_offset") // 1=M1, 2=M2, 3=M3 (dari forecast mana)
  notes                   String?
  isDeleted               Boolean   @default(false) @map("is_deleted")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  mps             MPS               @relation(fields: [mpsNumber], references: [mpsNumber], onDelete: Cascade)
  mbom            MBOMHeader?       @relation(fields: [mbomHeaderId], references: [id])
  part            Part?             @relation(fields: [partId], references: [id], onDelete: SetNull)
  forecastDetail  ForecastDetail?   @relation(fields: [forecastDetailId], references: [id], onDelete: SetNull)
  mrpRequirements MRPRequirement[]
  demandSources   MPSDemandSource[]

  @@index([mpsNumber])
  @@index([partCode])
  @@index([partId])
  @@index([mbomHeaderId])
  @@index([mbomSelectionDate])
  @@index([startDate])
  @@index([endDate])
  @@index([priority])
  @@index([status])
  @@index([soNumber])
  @@index([customerCode])
  @@index([deliveryPhaseId])
  @@index([fgRequiredDate])
  @@index([forecastDetailId])
  @@index([isDeleted])
  @@map("tbl_mps_detail")
}

// Many Forecast/SO lines can contribute to one consolidated MPS month/FG row.
// This table preserves that source-level quantity instead of hiding it in notes.
model MPSDemandSource {
  id                    String    @id @default(uuid())
  mpsDetailId           String    @map("mps_detail_id")
  sourceType            String    @map("source_type") // FORECAST, SALES_ORDER
  sourceNumber          String    @map("source_number")
  sourceLineId          String?   @map("source_line_id")
  forecastDetailId      String?   @map("forecast_detail_id")
  soDetailId            String?   @map("so_detail_id")
  customerCode          String?   @map("customer_code")
  periodMonth           DateTime  @map("period_month")
  qty                   Float
  uomCode               String?   @map("uom_code")
  requiredDate          DateTime? @map("required_date")
  effectiveRequiredDate DateTime? @map("effective_required_date")
  deliveryTargetId      String?   @map("delivery_target_id")
  targetDeliveryDate    DateTime? @map("target_delivery_date")
  fgRequiredDate        DateTime? @map("fg_required_date")
  priorityScore         Float?    @map("priority_score")
  priorityClass         String?   @map("priority_class")
  bufferPercent         Float     @default(0) @map("buffer_percent")
  bufferQty             Float     @default(0) @map("buffer_qty")
  sourcePegging         Json?     @map("source_pegging")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  mpsDetail      MPSDetail         @relation(fields: [mpsDetailId], references: [id], onDelete: Cascade)
  forecastDetail ForecastDetail?   @relation(fields: [forecastDetailId], references: [id], onDelete: SetNull)
  soDetail       SalesOrderDetail? @relation(fields: [soDetailId], references: [id], onDelete: SetNull)

  @@unique([mpsDetailId, sourceType, sourceNumber, sourceLineId])
  @@index([mpsDetailId])
  @@index([sourceType, sourceNumber])
  @@index([forecastDetailId])
  @@index([soDetailId])
  @@index([periodMonth])
  @@index([deliveryTargetId])
  @@map("tbl_mps_demand_source")
}

// Revision-bound audit of each customer delivery source consumed by an MPS.
// The live source timestamps are kept so approval can detect stale snapshots.
model MPSDeliveryFeasibilitySnapshot {
  id                      String    @id @default(uuid())
  mpsId                   String    @map("mps_id")
  mpsRevision             Int       @map("mps_revision")
  deliveryTargetId        String    @map("delivery_target_id")
  sourceType              String    @map("source_type")
  sourceNumber            String    @map("source_number")
  sourceLineId            String?   @map("source_line_id")
  partCode                String    @map("part_code")
  quantity                Float
  originalTargetDate      DateTime  @map("original_target_date")
  effectiveCommitmentDate DateTime? @map("effective_commitment_date")
  feasibilityStatus       String    @default("UNKNOWN") @map("feasibility_status")
  dispositionStatus       String    @default("NONE") @map("disposition_status")
  officialGateStatus      String    @default("BLOCKED") @map("official_gate_status")
  recoveryPlanId          String?   @map("recovery_plan_id")
  recoveryPlanRevision    Int?      @map("recovery_plan_revision")
  acceptLateNewDate       DateTime? @map("accept_late_new_date")
  acceptLateReason        String?   @map("accept_late_reason")
  decisionApprovedBy      String?   @map("decision_approved_by")
  decisionApprovedAt      DateTime? @map("decision_approved_at")
  targetUpdatedAt         DateTime? @map("target_updated_at")
  decisionUpdatedAt       DateTime? @map("decision_updated_at")
  recoveryUpdatedAt       DateTime? @map("recovery_updated_at")
  sourceFingerprint       String    @map("source_fingerprint")
  assessmentDetail        Json?     @map("assessment_detail")
  assessedAt              DateTime  @default(now()) @map("assessed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  mps MPS @relation(fields: [mpsId], references: [id], onDelete: Cascade)

  @@unique([mpsId, mpsRevision, deliveryTargetId])
  @@index([mpsId, mpsRevision])
  @@index([deliveryTargetId])
  @@index([feasibilityStatus, officialGateStatus])
  @@map("tbl_mps_delivery_feasibility_snapshot")
}

// PPIC delivery commitments created from an MPS.  One MPS line may be split
// across any number of phases, either to the next vendor process or to the
// customer for the final FG/COMP receipt.  This is a planning record; the
// physical shipment remains executed by Vendor Process Order / Delivery Schedule.
model MPSDeliveryPlan {
  id                     String    @id @default(uuid())
  mpsNumber              String    @map("mps_number")
  mpsDetailId            String?   @map("mps_detail_id")
  phaseNumber            Int       @map("phase_number")
  targetType             String    @map("target_type") // VENDOR, CUSTOMER
  targetCode             String    @map("target_code")
  targetName             String?   @map("target_name")
  partCode               String    @map("part_code")
  plannedDate            DateTime  @map("planned_date")
  fgRequiredDate         DateTime? @map("fg_required_date")
  fgFinishSplitNumber    Int?      @map("fg_finish_split_number")
  qtyPlanned             Float     @map("qty_planned")
  uomCode                String?   @map("uom_code")
  status                 String    @default("Planned") // Planned, Released, Completed, Cancelled
  notes                  String?
  sourceDeliveryTargetId String?   @map("source_delivery_target_id")
  sourceType             String?   @map("source_type")
  sourceNumber           String?   @map("source_number")
  lockedBySource         Boolean   @default(false) @map("locked_by_source")
  createdBy              String?   @map("created_by")
  isDeleted              Boolean   @default(false) @map("is_deleted")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  mps MPS @relation(fields: [mpsNumber], references: [mpsNumber], onDelete: Cascade)

  @@unique([mpsNumber, phaseNumber])
  @@index([mpsDetailId])
  @@index([plannedDate])
  @@index([fgRequiredDate])
  @@index([targetType, targetCode])
  @@index([sourceDeliveryTargetId])
  @@index([sourceType, sourceNumber])
  @@index([isDeleted])
  @@map("tbl_mps_delivery_plan")
}

// Delivery commitment is owned by Marketing. Forecast and SO can each be
// split into phases; planning consumes these records but cannot redefine them.
model DemandDeliveryTarget {
  id                       String   @id @default(uuid())
  sourceType               String   @map("source_type") // FORECAST, SALES_ORDER
  sourceNumber             String   @map("source_number")
  sourceLineId             String   @map("source_line_id")
  forecastDetailId         String?  @map("forecast_detail_id")
  soDetailId               String?  @map("so_detail_id")
  consumesForecastTargetId String?  @map("consumes_forecast_target_id")
  phaseNumber              Int      @map("phase_number")
  customerCode             String?  @map("customer_code")
  partCode                 String   @map("part_code")
  targetDate               DateTime @map("target_date")
  qty                      Float
  uomCode                  String?  @map("uom_code")
  status                   String   @default("ACTIVE")
  notes                    String?
  createdBy                String?  @map("created_by")
  updatedBy                String?  @map("updated_by")
  isDeleted                Boolean  @default(false) @map("is_deleted")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  forecastDetail ForecastDetail?   @relation(fields: [forecastDetailId], references: [id], onDelete: Cascade)
  soDetail       SalesOrderDetail? @relation(fields: [soDetailId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceLineId, phaseNumber])
  @@index([sourceNumber])
