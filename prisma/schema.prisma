  mbomCostHeader MBOMCostHeader @relation(fields: [mbomCostHeaderId], references: [id], onDelete: Cascade)
  mbomDetail     MBOMDetail?    @relation(fields: [mbomDetailId], references: [id])
  mbomProcess    MBOMProcess?   @relation(fields: [mbomProcessId], references: [id])

