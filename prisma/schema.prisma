// ============================================
// INVENTORY - STOCK MOVEMENT
// ============================================

model StockMovement {
  id                       String   @id @default(uuid())
  movementNumber           String   @unique @map("movement_number")
  movementDate             DateTime @default(now()) @map("movement_date")
  movementType             String   @map("movement_type") // IN, OUT, TRANSFER, ADJUSTMENT
  direction                String?  @map("direction") // IN, OUT (untuk TRANSFER akan tercatat 2 baris: OUT + IN)
  transactionType          String?  @map("transaction_type") // Kategori bisnis utama: PURCHASE_RECEIVE, QUALITY_RELEASE, QC_HOLD, PRODUCTION, SALES, RETURN, REJECT, REWORK, SCRAP, STOCK_OPNAME
  warehouseCode            String   @map("warehouse_code")
  rackCode                 String?  @map("rack_code")
  destinationWarehouseCode String?  @map("destination_warehouse_code")
  lotNumber                String?  @map("lot_number") // LOT untuk traceability
  destinationRackCode      String?  @map("destination_rack_code")
  partCode                 String?  @map("part_code")
  partNumber               String?  @map("part_number")
  partName                 String?  @map("part_name")
  productId                String?  @map("product_id")
  description              String?
  spec                     String?
  thickness                Float?   @map("thickness")
  width                    Float?
  CSP                      String?  @map("CSP")
  stockType                String?  @map("stock_type") // Snapshot kategori fisik inventory pada saat mutasi. Dari poType untuk purchasing, dari production flow untuk FG/Semi-Finished.
  qty                      Float
  deltaQty                 Float?   @map("delta_qty") // Signed qty: + masuk, - keluar
  qtyBefore                Float?   @map("qty_before")
  qtyAfter                 Float?   @map("qty_after")
  adjustmentType           String?  @map("adjustment_type") // INCREASE, DECREASE
  transferGroupId          String?  @map("transfer_group_id")
  uomCode                  String?  @map("uom_code")
  qualityBucket            String?  @map("quality_bucket")
  referenceType            String?  @map("reference_type") // Dokumen/proses sumber: GR, INCOMING_INSPECTION, QUALITY_INSPECTION, PRODUCTION_LOG, MANUFACTURING_ORDER, SO, STO, MRP
  referenceNumber          String?  @map("reference_number")
  notes                    String?
  performedBy              String?  @map("performed_by")
  isDeleted                Boolean  @default(false) @map("is_deleted")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  // Relations
  warehouse       Warehouse @relation(fields: [warehouseCode], references: [warehouseCode])
  rack            Rack?     @relation("sourceRack", fields: [rackCode], references: [rackCode], onDelete: SetNull)
  destinationRack Rack?     @relation("destinationRack", fields: [destinationRackCode], references: [rackCode], onDelete: SetNull)
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([movementNumber])
  @@index([movementDate])
  @@index([movementType])
  @@index([direction])
  @@index([transactionType])
  @@index([warehouseCode])
  @@index([rackCode])
  @@index([destinationWarehouseCode])
  @@index([destinationRackCode])
  @@index([lotNumber])
  @@index([transferGroupId])
  @@index([partCode])
  @@index([partNumber])
  @@index([partName])
  @@index([productId])
  @@index([spec])
  @@index([thickness])
  @@index([width])
  @@index([CSP])
  @@index([stockType])
  @@index([qualityBucket])
  @@index([referenceType])
  @@index([referenceNumber])
  @@index([isDeleted])
  @@map("tbl_stock_movement")
}

