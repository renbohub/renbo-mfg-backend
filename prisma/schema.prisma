// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUM
// ============================================

enum Status {
  Draft
  Pending
  Approved
  Rejected
  Active
  Inactive
  Obsolete
}

enum Category {
  inHouse
  Purchase
  Vendor
}

enum BomCostType {
  Material
  Process
  Overhead
}

enum DiesStatus {
  Active
  Maintenance
  Retired
  Scrapped
  Reserved
}

enum DiesOwnerType {
  Mitsutoyo
  Customer
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  fullName     String?  @map("full_name")
  email        String?
  employeeId   String?  @unique @map("employee_id")
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  listMenu     Json     @default("[]") @map("list_menu")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee        Employee?  @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)
  roleAssignments UserRole[]

  @@index([username])
  @@index([employeeId])
  @@index([isDeleted])
  @@map("tbl_users")
}

model ExportToken {
  id         String    @id @default(uuid())
  jti        String    @unique
  tokenName  String?   @map("token_name")
  issuedBy   String    @map("issued_by")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")
  revokeNote String?   @map("revoke_note")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([issuedBy])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("tbl_export_tokens")
}

// ============================================
// SYSTEM - LOGS
// ============================================

model Log {
  id           String @id @default(uuid())
  nameRoute    String @map("name_route") // ebom, mbom, customer, supplier, sales-order, dll
  action       String // create, update, delete, read, bulk-remove, dll
  method       String // GET, POST, PUT, DELETE, PATCH
  url          String
  statusCode   Int    @map("status_code")
  responseTime Int?   @map("response_time") // in milliseconds

  userId    String? @map("user_id")
  username  String?
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  entityId      String? @map("entity_id") // ID/identifier yang dimodifikasi (noReg, customerCode, dll)
  requestParams Json?   @map("request_params") // URL params
  changes       Json?   @map("changes") // Detail perubahan: { field: { old: x, new: y } }
  errorMessage  String? @map("error_message") // Error tracking

  createdAt DateTime @default(now()) @map("created_at")

  @@index([nameRoute])
  @@index([action])
  @@index([entityId])
  @@index([userId])
  @@index([username])
  @@index([statusCode])
  @@index([createdAt])
  @@map("tbl_logs")
}

model SystemSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique @map("setting_key")
  settingValue String   @map("setting_value")
  description  String?
  updatedBy    String?  @map("updated_by")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([settingKey])
  @@index([isDeleted])
  @@map("tbl_system_settings")
}

model MasterFormula {
  id             String    @id @default(uuid())
  formulaCode    String    @unique @map("formula_code")
  moduleCode     String    @map("module_code")
  formulaKey     String    @map("formula_key")
  formulaName    String    @map("formula_name")
  expression     String
  variables      Json?
  resultType     String    @default("number") @map("result_type")
  version        Int       @default(1)
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  effectiveFrom  DateTime? @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([moduleCode, formulaKey, version])
  @@index([moduleCode, formulaKey])
  @@index([isActive, isDeleted])
  @@map("tbl_master_formulas")
}

model Role {
  id          String   @id @default(uuid())
  roleCode    String   @unique @map("role_code")
  roleName    String   @map("role_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users         UserRole[]
  permissions   RolePermission[]
  approvalSteps ApprovalRuleStep[]

  @@index([roleCode])
  @@index([isActive])
  @@index([isDeleted])
  @@map("tbl_roles")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  isActive   Boolean  @default(true) @map("is_active")
  assignedBy String?  @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([isActive])
  @@map("tbl_user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  moduleCode   String   @map("module_code")
  pageCode     String   @map("page_code")
  resourceCode String?  @map("resource_code")
  actions      Json     @default("[]")
  dataScope    Json?    @map("data_scope")
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleCode, pageCode])
  @@index([roleId])
  @@index([moduleCode, pageCode])
  @@index([resourceCode])
  @@index([isActive])
  @@index([isDeleted])
  @@map("tbl_role_permissions")
}

model ApprovalRule {
  id                String    @id @default(uuid())
  ruleCode          String    @unique @map("rule_code")
  ruleName          String    @map("rule_name")
  moduleCode        String    @map("module_code")
  pageCode          String    @map("page_code")
  actionCode        String    @default("approve") @map("action_code")
  documentType      String?   @map("document_type")
  description       String?
  priority          Int       @default(100)
  minAmount         Float?    @map("min_amount")
  maxAmount         Float?    @map("max_amount")
  currencyCode      String?   @map("currency_code")
  conditions        Json?
  requireSequential Boolean   @default(true) @map("require_sequential")
  allowSelfApproval Boolean   @default(false) @map("allow_self_approval")
  effectiveFrom     DateTime? @map("effective_from")
  effectiveUntil    DateTime? @map("effective_until")
  isActive          Boolean   @default(true) @map("is_active")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  steps    ApprovalRuleStep[]
  requests ApprovalRequest[]

  @@index([ruleCode])
  @@index([moduleCode, pageCode, actionCode])
  @@index([priority])
  @@index([isActive])
  @@index([isDeleted])
  @@map("tbl_approval_rules")
}

model ApprovalRuleStep {
  id                String   @id @default(uuid())
  approvalRuleId    String   @map("approval_rule_id")
  stepOrder         Int      @map("step_order")
  stepName          String   @map("step_name")
  approverRoleId    String?  @map("approver_role_id")
  permissionAction  String   @default("approve") @map("permission_action")
  requiredApprovals Int      @default(1) @map("required_approvals")
  pendingStatus     String?  @map("pending_status")
  approvedStatus    String?  @map("approved_status")
  rejectedStatus    String?  @map("rejected_status")
  slaHours          Int?     @map("sla_hours")
  canDelegate       Boolean  @default(false) @map("can_delegate")
  isActive          Boolean  @default(true) @map("is_active")
  isDeleted         Boolean  @default(false) @map("is_deleted")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  rule    ApprovalRule     @relation(fields: [approvalRuleId], references: [id], onDelete: Cascade)
  role    Role?            @relation(fields: [approverRoleId], references: [id], onDelete: SetNull)
  actions ApprovalAction[]

  @@unique([approvalRuleId, stepOrder])
  @@index([approvalRuleId])
  @@index([approverRoleId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("tbl_approval_rule_steps")
}

model ApprovalRequest {
  id                String    @id @default(uuid())
  requestNumber     String    @unique @map("request_number")
  approvalRuleId    String    @map("approval_rule_id")
  moduleCode        String    @map("module_code")
  pageCode          String    @map("page_code")
  actionCode        String    @default("approve") @map("action_code")
  documentType      String?   @map("document_type")
  documentId        String    @map("document_id")
  documentNumber    String?   @map("document_number")
  amount            Float?
  currencyCode      String?   @map("currency_code")
  currentStep       Int       @default(1) @map("current_step")
  status            String    @default("Pending")
  context           Json?
  requestedByUserId String?   @map("requested_by_user_id")
  requestedBy       String?   @map("requested_by")
  requestedAt       DateTime  @default(now()) @map("requested_at")
  completedAt       DateTime? @map("completed_at")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  rule    ApprovalRule     @relation(fields: [approvalRuleId], references: [id], onDelete: Restrict)
  actions ApprovalAction[]

  @@index([moduleCode, pageCode, actionCode, documentId, isDeleted])
  @@index([requestNumber])
  @@index([approvalRuleId])
  @@index([moduleCode, pageCode, actionCode])
  @@index([documentId])
  @@index([status])
  @@index([requestedByUserId])
  @@index([isDeleted])
  @@map("tbl_approval_requests")
}

model ApprovalAction {
  id            String   @id @default(uuid())
  requestId     String   @map("request_id")
  ruleStepId    String?  @map("rule_step_id")
  stepOrder     Int      @map("step_order")
  action        String
  actedByUserId String?  @map("acted_by_user_id")
  actedBy       String?  @map("acted_by")
  notes         String?
  metadata      Json?
  actedAt       DateTime @default(now()) @map("acted_at")

  request ApprovalRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step    ApprovalRuleStep? @relation(fields: [ruleStepId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([ruleStepId])
  @@index([stepOrder])
  @@index([action])
  @@index([actedByUserId])
  @@map("tbl_approval_actions")
}

model NumberingRule {
  id                 String   @id @default(uuid())
  ruleKey            String   @unique @map("rule_key")
  ruleName           String   @map("rule_name")
  prefix             String   @default("")
  pattern            String   @default("{PREFIX}-{SEQ}")
  sequenceLength     Int      @default(4) @map("sequence_length")
  nextNumber         Int      @default(1) @map("next_number")
  incrementBy        Int      @default(1) @map("increment_by")
  processStep        Int      @default(10) @map("process_step")
  insertionStart     Int      @default(11) @map("insertion_start")
  siblingAlphaMode   String   @default("SAME_PROCESS") @map("sibling_alpha_mode")
  inheritBranchAlpha Boolean  @default(true) @map("inherit_branch_alpha")
  resetPolicy        String   @default("NONE") @map("reset_policy")
  lastResetKey       String?  @map("last_reset_key")
  isActive           Boolean  @default(true) @map("is_active")
  notes              String?
  updatedBy          String?  @map("updated_by")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([ruleKey])
  @@index([isActive])
  @@index([isDeleted])
  @@map("tbl_numbering_rules")
}

// ============================================
// MASTER DATA - UOM (Unit of Measure)
// ============================================

model Uom {
  id        String   @id @default(uuid())
  uomCode   String   @unique @map("uom_code")
  uomName   String?  @map("uom_name")
  category  String?  @map("category")
  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  mbomHeaders         MBOMHeader[]
  mbomDetails         MBOMDetail[]
  ebomHeaders         EBOMHeader[]
  ebomDetails         EBOMDetail[]
  salesOrderDetails   SalesOrderDetail[]
  quotationDetails    QuotationDetail[]
  products            Product[]
  productPriceLists   ProductPriceList[]
  manufacturingOrders ManufacturingOrder[]
  workOrders          WorkOrder[]
  conversionsFrom     UomConversion[]      @relation("UomConversionFrom")
  conversionsTo       UomConversion[]      @relation("UomConversionTo")
  itemUomMappings     ItemUomMapping[]

  @@index([uomCode])
  @@index([uomName])
  @@index([isDeleted])
  @@map("tbl_uom")
}

// ============================================
// MASTER DATA - CURRENCY
// ============================================

model Currency {
  id           String   @id @default(uuid())
  currencyCode String   @unique @map("currency_code")
  currencyName String?  @map("currency_name")
  symbol       String?
  exchangeRate Float    @default(1.0) @map("exchange_rate")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  customers          Customer[]
  salesOrderHeaders  SalesOrderHeader[]
  quotationHeaders   QuotationHeader[]
  vendorPriceLists   VendorPriceList[]
  partPriceLists     PartPriceList[]
  materialPriceLists MaterialPriceList[]
  productPriceLists  ProductPriceList[]
  mbomCostHeaders    MBOMCostHeader[]
  ebomCostHeaders    EBOMCostHeader[]
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]

  @@index([currencyCode])
  @@index([isDeleted])
  @@map("tbl_currency")
}

// ============================================
// MASTER DATA - CUSTOMER
// ============================================

model Customer {
  id                     String   @id @default(uuid())
  customerCode           String   @unique @map("customer_code")
  customerName           String?  @map("customer_name")
  contact                String?
  phone                  String?
  email                  String?
  billingAddress         String?  @map("billing_address")
  shippingAddress        String?  @map("shipping_address")
  currencyCode           String?  @map("currency_code")
  paymentTerms           String?  @map("payment_terms")
  taxId                  String?  @map("tax_id")
  notes                  String?
  status                 String? // Active, Inactive
  customerClassification String[] @default([]) @map("customer_classification") // Regular, Dies Only, Job Order
  isDeleted              Boolean  @default(false) @map("is_deleted")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  currency          Currency?          @relation(fields: [currencyCode], references: [currencyCode])
  salesOrderHeaders SalesOrderHeader[]
  quotationHeaders  QuotationHeader[]
  vendorPriceLists  VendorPriceList[]

  @@index([customerCode])
  @@index([customerName])
  @@index([contact])
  @@index([phone])
  @@index([email])
  @@index([currencyCode])
  @@index([isDeleted])
  @@map("tbl_customer")
}

// ============================================
// MASTER DATA - SUPPLIER
// ============================================

model Supplier {
  id              String   @id @default(uuid())
  supplierCode    String   @unique @map("supplier_code")
  supplierName    String?  @map("supplier_name")
  contact         String?
  phone           String?
  email           String?
  billingAddress  String?  @map("billing_address")
  shippingAddress String?  @map("shipping_address")
  leadTimeDays    Int?     @map("lead_time_days")
  taxId           String?  @map("tax_id")
  notes           String?
  status          String   @default("Active") // Active, Inactive
  users           String[] @default([]) // ["operational", "engineer", "other"]
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  materialPriceLists MaterialPriceList[]
  productPriceLists  ProductPriceList[]
  partPriceLists     PartPriceList[]
  entityProcesses    EntityVendorProcess[]
  mainBusinesses     SupplierMainBusiness[]
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]
  parts              Part[]
  supplierItems      SupplierItem[]

  @@index([supplierCode])
  @@index([supplierName])
  @@index([contact])
  @@index([phone])
  @@index([email])
  @@index([isDeleted])
  @@map("tbl_supplier")
}

// ============================================
// MASTER DATA - VENDOR
// ============================================

model Vendor {
  id              String   @id @default(uuid())
  vendorCode      String   @unique @map("vendor_code")
  vendorName      String?  @map("vendor_name")
  contact         String?
  phone           String?
  email           String?
  billingAddress  String?  @map("billing_address")
  shippingAddress String?  @map("shipping_address")
  leadTimeDays    Int?     @map("lead_time_days")
  taxId           String?  @map("tax_id")
  notes           String?
  status          String   @default("Active") // Active, Inactive
  users           String[] @default([]) // ["oprational", "engineer", "other"]
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  entityProcesses  EntityVendorProcess[]
  mainBusinesses   VendorMainBusiness[]
  vendorPriceLists VendorPriceList[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  @@index([vendorCode])
  @@index([vendorName])
  @@index([contact])
  @@index([phone])
  @@index([email])
  @@index([isDeleted])
  @@map("tbl_vendor")
}

// ============================================
// MASTER DATA - MAIN BUSINESS
// ============================================

model MainBusiness {
  id               String   @id @default(uuid())
  mainBusinessCode String   @unique @map("main_business_code")
  mainBusinessName String?  @map("main_business_name")
  notes            String?
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  vendors   VendorMainBusiness[]
  suppliers SupplierMainBusiness[]

  @@index([mainBusinessCode])
  @@index([mainBusinessName])
  @@index([isDeleted])
  @@map("tbl_main_business")
}

model VendorMainBusiness {
  id             String   @id @default(uuid())
  vendorId       String   @map("vendor_id")
  mainBusinessId String   @map("main_business_id")
  createdAt      DateTime @default(now()) @map("created_at")

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  mainBusiness MainBusiness @relation(fields: [mainBusinessId], references: [id], onDelete: Cascade)

  @@unique([vendorId, mainBusinessId])
  @@index([vendorId])
  @@index([mainBusinessId])
  @@map("tbl_vendor_main_business")
}

model SupplierMainBusiness {
  id             String   @id @default(uuid())
  supplierId     String   @map("supplier_id")
  mainBusinessId String   @map("main_business_id")
  createdAt      DateTime @default(now()) @map("created_at")

  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  mainBusiness MainBusiness @relation(fields: [mainBusinessId], references: [id], onDelete: Cascade)

  @@unique([supplierId, mainBusinessId])
  @@index([supplierId])
  @@index([mainBusinessId])
  @@map("tbl_supplier_main_business")
}

// ============================================
// MASTER DATA - VENDOR PROCESS
// ============================================

model VendorProcess {
  id                String   @id @default(uuid())
  category          String?  @map("category")
  vendorProcessCode String   @unique @map("vendor_process_code")
  vendorProcessName String?  @map("vendor_process_name")
  notes             String?
  isDeleted         Boolean  @default(false) @map("is_deleted")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  entityProcesses        EntityVendorProcess[]
  vendorPriceListDetails VendorPriceListDetail[]

  @@index([vendorProcessCode])
  @@index([vendorProcessName])
  @@index([category])
  @@index([isDeleted])
  @@map("tbl_vendor_process")
}

// ============================================
// MASTER DATA - ENTITY VENDOR PROCESS (UNIFIED JUNCTION)
// ============================================

model EntityVendorProcess {
  id              String   @id @default(uuid())
  entityType      String   @map("entity_type") // "vendor", "supplier", atau "vendorPriceList"
  vendorId        String?  @map("vendor_id")
  supplierId      String?  @map("supplier_id")
  priceListId     String?  @map("price_list_id")
  vendorProcessId String   @map("vendor_process_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  vendor        Vendor?          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  priceList     VendorPriceList? @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  vendorProcess VendorProcess    @relation(fields: [vendorProcessId], references: [id], onDelete: Cascade)

  @@unique([entityType, vendorId, supplierId, priceListId, vendorProcessId])
  @@index([entityType])
  @@index([vendorId])
  @@index([supplierId])
  @@index([priceListId])
  @@index([vendorProcessId])
  @@map("tbl_entity_vendorprocess")
}

// ============================================
// MASTER DATA - PART
// ============================================

model Part {
  id           String  @id @default(uuid())
  partCode     String  @unique @map("part_code")
  partNumber   String? @map("part_no")
  partName     String? @map("part_name")
  model        String?
  variant      String?
  customerCode String? @map("customer_code")

  // Multiple customers untuk purchase part
  customerCodes String[] @default([]) @map("customer_codes")

  itemType        String? @map("item_type") // FG, WIP, RAW
  rawType         String? @map("raw_type") // MATERIAL, PURCHASE_PART (only when itemType = RAW)
  partType        String  @default("STANDARD") @map("part_type") // STANDARD, COMP
  hasDrawing      Boolean @default(false) @map("has_drawing")
  componentLevel  Int     @default(0) @map("component_level")
  processSequence Int     @default(0) @map("process_sequence")
  bomLevel        Int     @default(0) @map("bom_level")
  branchCode      String? @map("branch_code")
  category        String? // e.g., PD, WD, MD, DLL
  status          String? @default("Active") // Active, Inactive
  statusService   String? @map("status_service") // Service, Non Service
  planningPolicy  String? @map("planning_policy") // MTO = SO-based, MTS = forecast-based
  assemblyPolicy  String  @default("INLINE") @map("assembly_policy") // INLINE, SUB_ASSEMBLY
  bufferStock     Float   @default(0) @map("buffer_stock") // Buffer stock percentage untuk planning

  // Normalized fields are nullable so legacy Part records remain valid.
  itemClass          String? @map("item_class")
  procurementType    String? @map("procurement_type")
  baseUomCode        String? @map("base_uom_code")
  purchaseUomCode    String? @map("purchase_uom_code")
  stockUomCode       String? @map("stock_uom_code")
  productionUomCode  String? @map("production_uom_code")
  salesUomCode       String? @map("sales_uom_code")
  defaultWarehouseId String? @map("default_warehouse_id")
  safetyStock        Float?  @map("safety_stock")

  // Transaction permissions mengikuti master Part pada Figma.
  canPurchase    Boolean @default(true) @map("can_purchase")
  canManufacture Boolean @default(true) @map("can_manufacture")
  canSell        Boolean @default(true) @map("can_sell")
  canStore       Boolean @default(true) @map("can_store")
  canUseInBom    Boolean @default(true) @map("can_use_in_bom")
  canSubcontract Boolean @default(true) @map("can_subcontract")
  canTrackLot    Boolean @default(true) @map("can_track_lot")
  canTrackSerial Boolean @default(true) @map("can_track_serial")

  materialId String? @map("material_id")
  supplierId String? @map("supplier_id")
  processId  String? @map("process_id")

  photos Json? @map("photos") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]

  noPhp     String? @map("no_php")
  statusPhp String? @map("status_php") // Non-Php, Php

  // Packing Info - BOX
  pcsPerBox Float? @map("pcs_per_box") // Pcs/Box
  kgPerBox  Float? @map("kg_per_box") // Kg/Box

  // Packing Info - Plastic
  packingPlastic   String? @map("packing_plastic") // Nama/jenis plastik
  pcsPerPlastic    Float?  @map("pcs_per_plastic") // Pcs per plastik
  kgPerPlastic     Float?  @map("kg_per_plastic") // Kg per plastik
  qtyPlasticPerBox Float?  @map("qty_plastic_per_box") // Qty plastik per box
  // qtyPcsPerBox dan qtyKgPerBox adalah calculated field di frontend

  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  mbomDetails          MBOMDetail[]
  mbomHeaders          MBOMHeader[]
  ebomDetails          EBOMDetail[]
  ebomHeaders          EBOMHeader[]
  quotationDetails     QuotationDetail[]
  salesOrderDetails    SalesOrderDetail[]
  vendorPriceLists     VendorPriceList[]
  partPriceLists       PartPriceList[]
  material             Material?            @relation(fields: [materialId], references: [id], onDelete: SetNull)
  supplier             Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  process              Process?             @relation(fields: [processId], references: [id], onDelete: SetNull)
  partBases            PartBase[]
  attachments          PartAttachment[]
  diesParts            DiesPart[]
  diesUsages           DiesUsage[]
  manufacturingOrders  ManufacturingOrder[]
  mpsDetails           MPSDetail[]
  mrpRequirements      MRPRequirement[]
  plannedOrders        PlannedOrder[]
  forecastDetails      ForecastDetail[]
  qualityInspections   QualityInspection[]
  mrpDirtyItems        MRPDirtyItem[]
  bomRelationsAsParent BOMRelation[]        @relation("BOMRelationParent")
  bomRelationsAsChild  BOMRelation[]        @relation("BOMRelationChild")
  itemLevelsAsRoot     ItemLevel[]          @relation("ItemLevelRoot")
  itemLevelsAsItem     ItemLevel[]          @relation("ItemLevelItem")
  mrpPeggings          MRPPegging[]
  supplierItems        SupplierItem[]
  itemUomMappings      ItemUomMapping[]
  routingHeaders       RoutingHeader[]

  @@index([partCode])
  @@index([partNumber])
  @@index([partName])
  @@index([model])
  @@index([variant])
  @@index([customerCode])
  @@index([itemType])
  @@index([rawType])
  @@index([partType])
  @@index([hasDrawing])
  @@index([componentLevel])
  @@index([processSequence])
  @@index([bomLevel])
  @@index([branchCode])
  @@index([assemblyPolicy])
  @@index([itemClass])
  @@index([procurementType])
  @@index([category])
  @@index([status])
  @@index([supplierId])
  @@index([processId])
  @@index([isDeleted])
  @@map("tbl_part")
}

// ============================================
// MASTER DATA - DIES (MOLD/TOOLING)
// ============================================

model Dies {
  id                  String            @id @default(uuid())
  diesCode            String            @unique @map("dies_code")
  diesNumber          String?           @map("dies_number") // Nomor fisik Dies
  diesName            String?           @map("dies_name")
  ownerType           DiesOwnerType     @default(Mitsutoyo) @map("owner_type") // Company atau Customer
  customerCode        String?           @map("customer_code") // Jika milik customer
  category            String? // Dies Only, Dies & Part
  status              DiesStatus        @default(Active)
  location            String? // Lokasi fisik dies (warehouse, storage)
  warehouseCode       String?           @map("warehouse_code")
  // Shot Counter Tracking
  shotCounter         Int               @default(0) @map("shot_counter") // Jumlah shot sudah dilakukan
  maxShotLifetime     Int?              @map("max_shot_lifetime") // Batas maksimal shot sebelum overhaul
  // Financial
  purchaseDate        DateTime?         @map("purchase_date")
  purchaseCost        Float?            @map("purchase_cost")
  currencyCode        String?           @default("IDR") @map("currency_code")
  depreciationRate    Float?            @map("depreciation_rate") // % per tahun
  // Maintenance Schedule
  lastMaintenanceDate DateTime?         @map("last_maintenance_date")
  nextMaintenanceDate DateTime?         @map("next_maintenance_date")
  maintenanceInterval Int?              @map("maintenance_interval") // Interval dalam hari
  // Specifications
  cavity              Int? // Jumlah cavity
  tonnage             Float? // Tonnage machine yang dibutuhkan
  cycleTime           Float?            @map("cycle_time") // Cycle time standar (detik)
  // Files & Documentation
  photos              Json?             @map("photos") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]
  drawings            Json?             @map("drawings") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]
  specs               Json?             @map("specs") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]
  notes               String?
  isDeleted           Boolean           @default(false) @map("is_deleted")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  // Relations
  diesParts           DiesPart[]
  maintenances        DiesMaintenance[]
  usages              DiesUsage[]
  workOrders          WorkOrder[]

  @@index([diesCode])
  @@index([diesNumber])
  @@index([diesName])
  @@index([ownerType])
  @@index([customerCode])
  @@index([category])
  @@index([status])
  @@index([location])
  @@index([warehouseCode])
  @@index([shotCounter])
  @@index([nextMaintenanceDate])
  @@index([isDeleted])
  @@map("tbl_dies")
}

// ============================================
// MASTER DATA - DIES-PART RELATION
// ============================================

model DiesPart {
  id             String    @id @default(uuid())
  diesId         String    @map("dies_id")
  partId         String    @map("part_id")
  isPrimary      Boolean   @default(true) @map("is_primary") // Dies utama untuk part ini?
  isActive       Boolean   @default(true) @map("is_active") // Masih aktif digunakan?
  effectiveDate  DateTime  @default(now()) @map("effective_date")
  expiryDate     DateTime? @map("expiry_date")
  expectedOutput Int?      @map("expected_output") // Expected output per shot (cavity)
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  // Relations
  dies           Dies      @relation(fields: [diesId], references: [id], onDelete: Cascade)
  part           Part      @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([diesId])
  @@index([partId])
  @@index([diesId, partId, isActive])
  @@index([isPrimary])
  @@index([isActive])
  @@map("tbl_dies_part")
}

// ============================================
// MASTER DATA - DIES MAINTENANCE HISTORY
// ============================================

model DiesMaintenance {
  id                  String    @id @default(uuid())
  diesId              String    @map("dies_id")
  maintenanceNumber   String    @unique @map("maintenance_number")
  maintenanceDate     DateTime  @default(now()) @map("maintenance_date")
  maintenanceType     String    @map("maintenance_type") // Preventive, Corrective, Overhaul, Inspection
  // Before Maintenance
  shotCounterBefore   Int?      @map("shot_counter_before")
  statusBefore        String?   @map("status_before")
  // Work Performed
  workDescription     String?   @map("work_description")
  partsReplaced       String?   @map("parts_replaced") // List parts yang diganti
  // After Maintenance
  shotCounterReset    Boolean   @default(false) @map("shot_counter_reset") // Reset counter?
  statusAfter         String?   @map("status_after")
  // Vendor/Workshop
  performedBy         String?   @map("performed_by")
  vendorCode          String?   @map("vendor_code") // Jika maintenance by vendor
  // Financial
  cost                Float?    @default(0)
  currencyCode        String?   @default("IDR") @map("currency_code")
  // Downtime
  startDate           DateTime? @map("start_date")
  endDate             DateTime? @map("end_date")
  downtime            Float?    @map("downtime") // in minutes
  // Next Schedule
  nextMaintenanceDate DateTime? @map("next_maintenance_date")
  notes               String?
  isDeleted           Boolean   @default(false) @map("is_deleted")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  // Relations
  dies                Dies      @relation(fields: [diesId], references: [id], onDelete: Cascade)

  @@index([diesId])
  @@index([maintenanceNumber])
  @@index([maintenanceDate])
  @@index([maintenanceType])
  @@index([vendorCode])
  @@index([isDeleted])
  @@map("tbl_dies_maintenance")
}

// ============================================
// MASTER DATA - DIES USAGE TRACKING
// ============================================

model DiesUsage {
  id              String     @id @default(uuid())
  diesId          String     @map("dies_id")
  partId          String?    @map("part_id")
  usageDate       DateTime   @default(now()) @map("usage_date")
  // Production Reference
  referenceType   String?    @map("reference_type") // SO, MANUFACTURING_ORDER, MPS
  referenceNumber String?    @map("reference_number")
  // Usage Details
  shotCount       Int        @default(0) @map("shot_count") // Jumlah shot dalam usage ini
  qtyProduced     Float      @default(0) @map("qty_produced") // Qty part produced
  qtyGood         Float      @default(0) @map("qty_good") // Qty good/accepted
  qtyReject       Float      @default(0) @map("qty_reject") // Qty reject
  // Machine & Operator
  machineCode     String?    @map("machine_code")
  operatorName    String?    @map("operator_name")
  shift           String? // 1A, 1B, 2A, 2B, 3A, 3C
  // Duration
  startTime       DateTime?  @map("start_time")
  endTime         DateTime?  @map("end_time")
  runningMinutes  Float?     @map("running_minutes")
  notes           String?
  isDeleted       Boolean    @default(false) @map("is_deleted")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  // Relations
  dies            Dies       @relation(fields: [diesId], references: [id], onDelete: Cascade)
  part            Part?      @relation(fields: [partId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?

  @@index([diesId])
  @@index([usageDate])
  @@index([partId])
  @@index([referenceType])
  @@index([referenceNumber])
  @@index([machineCode])
  @@index([isDeleted])
  @@map("tbl_dies_usage")
}

// ============================================
// MASTER DATA - MACHINE
// ============================================

model Machine {
  id           String  @id @default(uuid())
  machineCode  String  @unique @map("machine_code")
  machineName  String? @map("machine_name")
  machineType  String? @map("machine_type") // Press, Injection, CNC, Welding, dll
  brand        String? // Merek/pabrikan
  modelNumber  String? @map("model_number") // Nomor model
  serialNumber String? @map("serial_number") // Nomor seri

  // Spesifikasi Teknis
  capacity     Float? // Kapasitas produksi
  capacityUnit String? @map("capacity_unit") // Satuan kapasitas (pcs/jam, kg/jam, dll)
  tonnage      Float? // Tonnage (untuk mesin press)
  powerKw      Float?  @map("power_kw") // Daya listrik (kW)
  voltage      Float? // Tegangan (V)
  cycleTime    Float?  @map("cycle_time") // Cycle time standar (detik)

  // Lokasi
  location      String? // Lokasi fisik mesin
  warehouseCode String? @map("warehouse_code")
  lineCode      String? @map("line_code") // Kode lini produksi

  // Status
  status String @default("Active") // Active, Inactive, Maintenance, Retired

  // Informasi Pembelian & Keuangan
  purchaseDate     DateTime? @map("purchase_date")
  purchaseCost     Float?    @map("purchase_cost")
  currencyCode     String?   @default("IDR") @map("currency_code")
  depreciationRate Float?    @map("depreciation_rate") // % per tahun
  costingRate      Float?    @map("costing_rate") // Rate standar untuk costing proses
  costingRateType  String?   @default("PER_HOUR") @map("costing_rate_type") // PER_SECOND, PER_MINUTE, PER_HOUR, PER_CYCLE

  // Jadwal Maintenance
  lastMaintenanceDate DateTime? @map("last_maintenance_date")
  nextMaintenanceDate DateTime? @map("next_maintenance_date")
  maintenanceInterval Int?      @map("maintenance_interval") // Interval dalam hari

  // Dokumentasi
  photos   Json? @map("photos") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]
  drawings Json? @map("drawings") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]

  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  workOrders         WorkOrder[]
  mbomProcesses      MBOMProcess[]
  workCenterMachines WorkCenterMachine[]

  @@index([machineCode])
  @@index([machineName])
  @@index([machineType])
  @@index([brand])
  @@index([status])
  @@index([location])
  @@index([warehouseCode])
  @@index([lineCode])
  @@index([nextMaintenanceDate])
  @@index([isDeleted])
  @@map("tbl_machine")
}

model PartBase {
  id String @id @default(uuid())

  partId String @map("part_id")

  baseOn String @map("base_on") // e.g., "Quotation", "Actual", dll

  CSP String? @map("CSP") // e.g., C, S, P

  thickness   Float? // T
  width       Float? // W
  length      Float? // P/L
  cavity      Int? // CAV
  netWeight   Float? @map("net_weight") // Berat part jadi
  scrapWeight Float? @map("scrap_weight") // Berat scrap aktual yang dihasilkan
  grossWeight Float? @map("gross_weight") // Total material awal (net + scrap)

  cycleTime Float? @map("cycle_time") // CT: Cycle time (detik) — CT-Q jika baseOn=Quotation, CT-A jika baseOn=Actual

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("tbl_part_base")
}

// ============================================
// MASTER DATA - PART ATTACHMENT
// ============================================

model PartAttachment {
  id          String   @id @default(uuid())
  partId      String   @map("part_id")
  title       String // Title/label untuk file (e.g., "Technical Drawing", "Photo", "Spec Sheet")
  // fileName    String   @map("file_name")
  // fileUrl     String   @map("file_url")
  // fileType    String?  @map("file_type") // image/jpeg, application/pdf, dll
  // fileSize    Int?     @map("file_size") // in bytes
  files       Json     @map("files") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]
  description String?
  uploadedBy  String?  @map("uploaded_by")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@index([title])
  @@index([isDeleted])
  @@map("tbl_part_attachment")
}

// ============================================
// MASTER DATA - MATERIAL
// ============================================

model Material {
  id             String  @id @default(uuid())
  materialCode   String  @unique @map("material_code")
  materialName   String? @map("material_name")
  materialType   String? @map("material_type")
  itemCategory   String? @map("item_category")
  materialFamily String? @map("material_family")
  materialForm   String? @map("material_form")
  materialGrade  String? @map("material_grade")
  attributeSet   String? @map("attribute_set")
  status         String? @default("Draft")
  canTrackLot    Boolean @default(false) @map("can_track_lot")
  spec           String?
  thickness      Float?
  width          Float?
  CSP            String? @map("CSP")
  density        Float?  @map("density")

  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  materialPriceLists MaterialPriceList[]
  parts              Part[]
  attributeValues    MaterialAttributeValue[]

  @@index([materialCode])
  @@index([materialType])
  @@index([materialFamily])
  @@index([materialForm])
  @@index([spec])
  @@index([thickness])
  @@index([width])
  @@index([CSP])
  @@index([isDeleted])
  @@map("tbl_material")
}

// Additive material specification structure. Legacy Material fields remain the fallback.
model MaterialAttributeSet {
  id          String   @id @default(uuid())
  setCode     String   @unique @map("set_code")
  setName     String   @map("set_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  definitions MaterialAttributeDefinition[]

  @@index([isActive])
  @@index([isDeleted])
  @@map("tbl_material_attribute_set")
}

model MaterialAttributeDefinition {
  id             String   @id @default(uuid())
  attributeSetId String   @map("attribute_set_id")
  attributeCode  String   @map("attribute_code")
  attributeName  String   @map("attribute_name")
  dataType       String   @default("TEXT") @map("data_type")
  unitCode       String?  @map("unit_code")
  isRequired     Boolean  @default(false) @map("is_required")
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  attributeSet MaterialAttributeSet     @relation(fields: [attributeSetId], references: [id], onDelete: Cascade)
  values       MaterialAttributeValue[]

  @@unique([attributeSetId, attributeCode])
  @@index([attributeSetId])
  @@map("tbl_material_attribute_definition")
}

model MaterialAttributeValue {
  id                    String   @id @default(uuid())
  materialId            String   @map("material_id")
  attributeDefinitionId String   @map("attribute_definition_id")
  valueText             String?  @map("value_text")
  valueNumber           Float?   @map("value_number")
  valueBoolean          Boolean? @map("value_boolean")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  material            Material                    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  attributeDefinition MaterialAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([materialId, attributeDefinitionId])
  @@index([materialId])
  @@index([attributeDefinitionId])
  @@map("tbl_material_attribute_value")
}

model UomConversion {
  id          String   @id @default(uuid())
  fromUomCode String   @map("from_uom_code")
  toUomCode   String   @map("to_uom_code")
  factor      Float
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  fromUom Uom @relation("UomConversionFrom", fields: [fromUomCode], references: [uomCode])
  toUom   Uom @relation("UomConversionTo", fields: [toUomCode], references: [uomCode])

  @@unique([fromUomCode, toUomCode])
  @@index([fromUomCode])
  @@index([toUomCode])
  @@map("tbl_uom_conversion")
}

model ItemUomMapping {
  id        String   @id @default(uuid())
  partId    String   @map("part_id")
  uomCode   String   @map("uom_code")
  usageType String   @default("STOCK") @map("usage_type")
  factor    Float    @default(1)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)
  uom  Uom  @relation(fields: [uomCode], references: [uomCode])

  @@unique([partId, uomCode, usageType])
  @@index([partId])
  @@index([uomCode])
  @@map("tbl_item_uom_mapping")
}

model SupplierItem {
  id               String    @id @default(uuid())
  supplierId       String    @map("supplier_id")
  partId           String    @map("part_id")
  supplierItemCode String?   @map("supplier_item_code")
  leadTimeDays     Int?      @map("lead_time_days")
  moq              Float?
  orderMultiple    Float?    @map("order_multiple")
  packSize         Float?    @map("pack_size")
  purchaseUomCode  String?   @map("purchase_uom_code")
  isPreferred      Boolean   @default(false) @map("is_preferred")
  priority         Int       @default(100)
  price            Float?
  currencyCode     String?   @map("currency_code")
  validFrom        DateTime? @map("valid_from")
  validUntil       DateTime? @map("valid_until")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  part     Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([supplierId, partId, supplierItemCode])
  @@index([supplierId])
  @@index([partId])
  @@index([isPreferred])
  @@map("tbl_supplier_item")
}

model WorkCenter {
  id                    String              @id @default(uuid())
  workCenterCode        String              @unique @map("work_center_code")
  workCenterName        String              @map("work_center_name")
  plantCode             String?             @map("plant_code")
  lineCode              String?             @map("line_code")
  capacityMinutesPerDay Float?              @map("capacity_minutes_per_day")
  efficiencyPercent     Float               @default(100) @map("efficiency_percent")
  isActive              Boolean             @default(true) @map("is_active")
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  machines              WorkCenterMachine[]
  routingOperations     RoutingOperation[]

  @@map("tbl_work_center")
}

model WorkCenterMachine {
  id           String     @id @default(uuid())
  workCenterId String     @map("work_center_id")
  machineId    String     @map("machine_id")
  isPrimary    Boolean    @default(false) @map("is_primary")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  machine      Machine    @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([workCenterId, machineId])
  @@map("tbl_work_center_machine")
}

model RoutingHeader {
  id             String             @id @default(uuid())
  routingCode    String             @unique @map("routing_code")
  partId         String?            @map("part_id")
  revision       String             @default("1")
  status         String             @default("DRAFT")
  effectiveFrom  DateTime?          @map("effective_from")
  effectiveUntil DateTime?          @map("effective_until")
  notes          String?
  isDeleted      Boolean            @default(false) @map("is_deleted")
  createdAt      DateTime           @default(now()) @map("created_at")
