// ============================================
// PRODUCTION - MBOM PROCESS
// ============================================

model MBOMProcess {
  id                       String   @id @default(uuid())
  noReg                    String   @map("no_reg")
  mbomDetailId             String   @map("bom_detail_id")
  processId                String   @map("process_id")
  occurrenceCode           String?  @map("occurrence_code")
  routingNumber            String?  @map("routing_number")
  machineId                String?  @map("machine_id")
  machineSpecificationCode String?  @map("machine_specification_code") // Capability requirement; physical asset is assigned in Capacity Planning
  alternativeMachineIds    Json?    @map("alternative_machine_ids") // Legacy only; no longer used by BOM or Capacity Planning
  diesId                   String?  @map("dies_id")
  routingMode              String   @default("INHOUSE") @map("routing_mode") // INHOUSE atau VENDOR
  vendorId                 String?  @map("vendor_id")
  routingOperationId       String?  @map("routing_operation_id")
  sequence                 Int      @default(0)
  cycleTime                Float    @default(0) @map("cycle_time")
  notes                    String?
  isDeleted                Boolean  @default(false) @map("is_deleted")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  // Relations
  mbomDetail                MBOMDetail?                @relation(fields: [mbomDetailId], references: [id], onDelete: Cascade)
  process                   Process?                   @relation(fields: [processId], references: [id])
  machine                   Machine?                   @relation(fields: [machineId], references: [id], onDelete: SetNull)
  dies                      Dies?                      @relation(fields: [diesId], references: [id], onDelete: SetNull)
  vendor                    Vendor?                    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  routingOperation          RoutingOperation?          @relation(fields: [routingOperationId], references: [id], onDelete: SetNull)
  mbomcostDetails           MBOMCostDetail[]
  capacityMachineOverrides  CapacityMachineOverride[]
  productionPlanAllocations ProductionPlanAllocation[]
  workOrders                WorkOrder[]
  dailyProductionSchedules  DailyProductionSchedule[]

  @@index([noReg])
  @@index([mbomDetailId])
  @@index([processId])
  @@index([occurrenceCode])
  @@index([routingNumber])
  @@index([machineId])
  @@index([machineSpecificationCode])
  @@index([diesId])
  @@index([vendorId])
  @@index([routingMode])
  @@index([routingOperationId])
  @@index([sequence])
  @@index([isDeleted])
  @@map("tbl_mbomprocess")
}

// ============================================
// PRODUCTION - MBOM COST HEADER
// ============================================

model MBOMCostHeader {
  id           String  @id @default(uuid())
  mbomId       String  @map("mbom_id") // FK → MBOMHeader.id (lebih aman)
  costVersion  Int     @default(1) @map("cost_version")
  qtyBase      Float   @default(1) @map("qty_base")
  currencyCode String  @map("currency_code")
  costModel    String? @map("cost_model") // misal: STANDARD, CURRENT, QUOTE, dll

  materialCost Float  @default(0) @map("material_cost")
  processCost  Float  @default(0) @map("process_cost")
  overheadCost Float  @default(0) @map("overhead_cost")
  totalCost    Float  @default(0) @map("total_cost")
  costPerUnit  Float? @map("cost_per_unit") // Cost per unit kalkulasi

  status     Status  @default(Draft) // Draft, Active, Obsolete
  isStandard Boolean @default(false) @map("is_standard")

  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")

  notes     String?
  createdBy String?  @map("created_by")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  mbom     MBOMHeader       @relation(fields: [mbomId], references: [id], onDelete: Cascade)
  currency Currency         @relation(fields: [currencyCode], references: [currencyCode])
  details  MBOMCostDetail[]

  @@index([mbomId])
  @@index([currencyCode])
  @@index([status])
  @@index([isStandard])
  @@index([isDeleted])
  @@map("tbl_mbomcost_header")
}

// ============================================
// PRODUCTION - MBOM COST DETAIL
// ============================================

model MBOMCostDetail {
  id               String      @id @default(uuid())
  mbomCostHeaderId String      @map("mbom_cost_header_id")
  type             BomCostType @default(Material) // Material, Process, Overhead

  mbomDetailId  String? @map("mbom_detail_id") // kalau MATERIAL
  mbomProcessId String? @map("mbom_process_id") // kalau PROCESS
  machineId     String? @map("machine_id") // snapshot reference dari MBOMProcess saat costing dibuat

  machineCodeSnapshot     String? @map("machine_code_snapshot")
  machineNameSnapshot     String? @map("machine_name_snapshot")
  machineRateTypeSnapshot String? @map("machine_rate_type_snapshot")

  qty    Float @default(0)
  rate   Float @default(0)
  amount Float @default(0)

  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
