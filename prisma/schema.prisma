  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([snapshotDate])
  @@index([runScope])
  @@index([status])
  @@map("tbl_mrp_partial_snapshot")
}

// ============================================
// PURCHASING - PURCHASE REQUISITION (PR)
// ============================================

model PurchaseRequisition {
  id              String    @id @default(uuid())
  prNumber        String    @unique @map("pr_number")
  prDate          DateTime  @default(now()) @map("pr_date")
  requestedBy     String?   @map("requested_by")
  departmentId    String?   @map("department_id")
  requiredDate    DateTime  @map("required_date")
  priority        String    @default("Normal") // Normal, Urgent, Critical
  poType          String    @default("Other") @map("po_type") // Consumable, Material, Out Process, Maintenance, Service, Asset, Other
  sourceType      String    @default("MANUAL") @map("source_type") // MANUAL, MRP, SYSTEM; explicit origin for audit/filtering
  status          String    @default("Draft") // Draft, Submitted, Approved, Rejected, Partially Ordered, Completed
  totalAmount     Float     @default(0) @map("total_amount")
  approvedBy      String?   @map("approved_by")
  approvedDate    DateTime? @map("approved_date")
  rejectedBy      String?   @map("rejected_by")
  rejectedDate    DateTime? @map("rejected_date")
  rejectionReason String?   @map("rejection_reason")
  convertedToPO   String?   @map("converted_to_po") // PO Number
  notes           String?
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  details        PurchaseRequisitionDetail[]
  purchaseOrders PurchaseOrderPR[]
  department     Department?                 @relation(fields: [departmentId], references: [id])

  @@index([prNumber])
  @@index([prDate])
  @@index([requestedBy])
  @@index([departmentId])
  @@index([priority])
  @@index([poType])
  @@index([sourceType])
  @@index([status])
  @@index([requiredDate])
  @@index([isDeleted])
  @@map("tbl_purchase_requisition")
}

// ============================================
// PURCHASING - PURCHASE REQUISITION DETAIL
// ============================================

model PurchaseRequisitionDetail {
  id                        String    @id @default(uuid())
  prNumber                  String    @map("pr_number")
  lineNumber                Int       @map("line_number")
  partCode                  String?   @map("part_code") // untuk Material, Out Process
  partNumber                String?   @map("part_number")
  partName                  String?   @map("part_name")
  materialId                String?   @map("material_id") // Snapshot reference Material Master; nullable untuk legacy/manual PR
  materialCode              String?   @map("material_code")
  materialName              String?   @map("material_name")
  materialType              String?   @map("material_type")
  productId                 String?   @map("product_id") // untuk Consumable
  description               String?   @map("description") // untuk Maintenance, Service, Asset
  spec                      String? // Snapshot dari PartBase Material Specification
  thickness                 Float? // Snapshot dari PartBase
  width                     Float? // Snapshot dari PartBase
  CSP                       String?   @map("CSP") // Snapshot dari PartBase
  qty                       Float
  orderedQty                Float     @default(0) @map("ordered_qty") // Total qty yang sudah di-PO-kan
  uomCode                   String?   @map("uom_code")
  estimatedPrice            Float     @default(0) @map("estimated_price")
  totalAmount               Float     @default(0) @map("total_amount")
  preferredSupplier         String?   @map("preferred_supplier")
  proposedSupplierCode      String?   @map("proposed_supplier_code") // Proposal supplier dari layer PPIC/MRP
  confirmedSupplierCode     String?   @map("confirmed_supplier_code") // Konfirmasi supplier layer Purchasing/PR
  supplierConfirmedBy       String?   @map("supplier_confirmed_by")
  supplierConfirmedAt       DateTime? @map("supplier_confirmed_at")
  supplierProposalSource    String?   @map("supplier_proposal_source") // PART_MASTER, PPIC, atau PURCHASING
  lotCount                  Float?    @map("lot_count")
  kgPerLot                  Float?    @map("kg_per_lot")
  purchaseQtyKg             Float?    @map("purchase_qty_kg")
  lotAllocations            Json?     @map("lot_allocations") // Pegging lot ke beberapa part/FG
  preferredVendor           String?   @map("preferred_vendor")
  plannedOrderNumber        String?   @map("planned_order_number") // Reference dari MRP
  sourcePlannedOrderNumbers Json?     @map("source_planned_order_numbers") // Semua planned order saat kebutuhan material dikonsolidasi
  notes                     String?
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  // Relations
  pr        PurchaseRequisition   @relation(fields: [prNumber], references: [prNumber], onDelete: Cascade)
  product   Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  poDetails PurchaseOrderDetail[]

  @@index([prNumber])
  @@index([partCode])
  @@index([materialCode])
  @@index([productId])
  @@index([preferredSupplier])
  @@index([proposedSupplierCode])
  @@index([confirmedSupplierCode])
  @@index([preferredVendor])
  @@index([plannedOrderNumber])
  @@index([isDeleted])
  @@map("tbl_purchase_requisition_detail")
}

// ============================================
// PURCHASING - PURCHASE ORDER (PO)
// ============================================

model PurchaseOrder {
  id              String    @id @default(uuid())
  poNumber        String    @unique @map("po_number")
  poDate          DateTime  @default(now()) @map("po_date")
  supplierCode    String?   @map("supplier_code")
  supplierName    String?   @map("supplier_name")
  vendorCode      String?   @map("vendor_code")
  vendorName      String?   @map("vendor_name")
  contact         String?
  phone           String?
  email           String?
  billingAddress  String?   @map("billing_address")
  shippingAddress String?   @map("shipping_address")
  deliveryDate    DateTime  @map("delivery_date")
  paymentTerms    String?   @map("payment_terms")
  quotationNumber String?   @map("quotation_number")
  quotationFiles  Json?     @map("quotation_files") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]
  poType          String    @default("Other") @map("po_type") // Consumable, Material, Out Process, Maintenance, Service, Asset, Other
  currencyCode    String    @default("IDR") @map("currency_code")
  status          String    @default("Draft") // Draft, Checking by Operational Manager, Checking by Engineering Manager, Checking by Sacho, Approved, Revising, Rejected, Sent, Confirmed, Partial Receipt, Completed, Cancelled
  totalAmount     Float     @default(0) @map("total_amount")
  notes           String?
  createdBy       String?   @map("created_by")
  checkedBy       String?   @map("checked_by")
  checkedDate     DateTime? @map("checked_date")
  approvedBy      String?   @map("approved_by")
  approvedDate    DateTime? @map("approved_date")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  purchaseRequisitions PurchaseOrderPR[]
  comments             PurchaseOrderComment[]
  supplier             Supplier?              @relation(fields: [supplierCode], references: [supplierCode], onDelete: SetNull)
  vendor               Vendor?                @relation(fields: [vendorCode], references: [vendorCode], onDelete: SetNull)
  currency             Currency               @relation(fields: [currencyCode], references: [currencyCode])
  details              PurchaseOrderDetail[]
  goodsReceipts        GoodsReceipt[]
  purchaseInvoices     PurchaseInvoice[]      @relation("PurchaseInvoicePrimaryPO")
  purchaseInvoiceLinks PurchaseInvoicePO[]

  @@index([poNumber])
  @@index([poDate])
  @@index([supplierCode])
  @@index([deliveryDate])
  @@index([quotationNumber])
  @@index([status])
  @@index([poType])
  @@index([currencyCode])
  @@index([isDeleted])
  @@map("tbl_purchase_order")
}

model PurchaseOrderComment {
  id         String   @id @default(uuid())
  poNumber   String   @map("po_number")
  parentId   String?  @map("parent_id")
  type       String   @default("revision")
  message    String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  createdBy  String?  @map("created_by")
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  po      PurchaseOrder          @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  parent  PurchaseOrderComment?  @relation("PurchaseOrderCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PurchaseOrderComment[] @relation("PurchaseOrderCommentReplies")

  @@index([poNumber])
  @@index([parentId])
  @@index([type])
  @@index([createdBy])
  @@index([userId])
  @@index([createdAt])
  @@map("tbl_purchase_order_comments")
}

// ============================================
// PURCHASING - PURCHASE ORDER PR (JUNCTION)
// ============================================

model PurchaseOrderPR {
  id       String @id @default(uuid())
  poNumber String @map("po_number")
  prNumber String @map("pr_number")

  // Relations
  po PurchaseOrder       @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  pr PurchaseRequisition @relation(fields: [prNumber], references: [prNumber], onDelete: Cascade)

  @@unique([poNumber, prNumber])
  @@index([poNumber])
  @@index([prNumber])
  @@map("tbl_purchase_order_pr")
}

// ============================================
// PURCHASING - PURCHASE ORDER DETAIL
// ============================================

model PurchaseOrderDetail {
  id                   String    @id @default(uuid())
  poNumber             String    @map("po_number")
  lineNumber           Int       @map("line_number")
  prDetailId           String?   @map("pr_detail_id") // FK ke PurchaseRequisitionDetail (opsional)
  productId            String?   @map("product_id") // Reference ke Product (utama untuk Consumable)
  description          String?   @map("description") // Deskripsi item, wajib untuk Maintenance/Service/Asset
  partCode             String?   @map("part_code") // Utama untuk Material, Out Process
  partNumber           String?   @map("part_number")
  partName             String?   @map("part_name")
  materialId           String?   @map("material_id") // Snapshot Material Master dari PR
  materialCode         String?   @map("material_code")
  materialName         String?   @map("material_name")
  materialType         String?   @map("material_type")
  spec                 String? // Snapshot dari PartBase Material Specification
  thickness            Float? // Snapshot dari PartBase
  width                Float? // Snapshot dari PartBase
  CSP                  String?   @map("CSP") // Snapshot dari PartBase
  qty                  Float
  uomCode              String?   @map("uom_code")
  unitPrice            Float     @default(0) @map("unit_price")
  vendorPriceListId    String?   @map("vendor_price_list_id")
  vendorPriceBreakdown Json?     @map("vendor_price_breakdown")
  discount             Float     @default(0)
  discountType         String    @default("percent") @map("discount_type") // "percent" atau "nominal"
  tax                  Float     @default(0)
  totalAmount          Float     @default(0) @map("total_amount")
  qtyReceived          Float     @default(0) @map("qty_received") // Tracking qty received via GR
  deliveryDate         DateTime? @map("delivery_date")
  category             String?   @map("category") // Office, PSE, PD, WD, MD, DIES, TOOLS, MCN
  notes                String?
  isDeleted            Boolean   @default(false) @map("is_deleted")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  po                     PurchaseOrder              @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  prDetail               PurchaseRequisitionDetail? @relation(fields: [prDetailId], references: [id], onDelete: SetNull)
  product                Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  vendorPriceList        VendorPriceList?           @relation(fields: [vendorPriceListId], references: [id], onDelete: SetNull)
  goodsReceiptDetails    GoodsReceiptDetail[]
  purchaseInvoiceDetails PurchaseInvoiceDetail[]

  @@index([poNumber])
  @@index([prDetailId])
  @@index([partCode])
  @@index([productId])
  @@index([vendorPriceListId])
  @@index([uomCode])
  @@index([category])
  @@index([isDeleted])
  @@map("tbl_purchase_order_detail")
}

// ============================================
// PURCHASING - GOODS RECEIPT (GR)
// ============================================

model GoodsReceipt {
  id                 String    @id @default(uuid())
  grNumber           String    @unique @map("gr_number")
  grDate             DateTime  @default(now()) @map("gr_date")
  poNumber           String    @map("po_number")
  poType             String?   @map("po_type") // Copy dari PO header: Consumable, Material, Out Process, Maintenance, Service, Asset
  stockType          String?   @map("stock_type") // Kategori inventory hasil mapping poType untuk GR/StockMovement purchasing: Consumable, Material, OutProcess, Maintenance, Service, Asset
  warehouseCode      String    @map("warehouse_code") // Destination warehouse
  deliveryNoteNumber String?   @map("delivery_note_number") // Default nomor surat jalan untuk detail GR
  receivedBy         String?   @map("received_by")
  receivedDate       DateTime? @map("received_date")
  status             String    @default("Draft") // Draft, Received Pending Inspection, Partially Inspected, Completed, Cancelled
  notes              String?
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  po                  PurchaseOrder        @relation(fields: [poNumber], references: [poNumber])
  warehouse           Warehouse            @relation(fields: [warehouseCode], references: [warehouseCode])
  details             GoodsReceiptDetail[]
  incomingInspections IncomingInspection[]

  @@index([grNumber])
  @@index([grDate])
  @@index([poNumber])
  @@index([poType])
  @@index([warehouseCode])
  @@index([deliveryNoteNumber])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_goods_receipt")
}

// ============================================
// PURCHASING - GOODS RECEIPT DETAIL
// ============================================

model GoodsReceiptDetail {
  id                 String   @id @default(uuid())
  grNumber           String   @map("gr_number")
  lineNumber         Int      @map("line_number")
  poDetailId         String   @map("po_detail_id")
  qtyOrdered         Float    @map("qty_ordered")
  qtyReceived        Float    @map("qty_received") // Actual received
  qtyInspected       Float    @default(0) @map("qty_inspected") // Akumulasi qty yang sudah di-inspection
  deliveryNoteNumber String?  @map("delivery_note_number") // Nomor surat jalan per detail
  deliveryNoteFiles  Json?    @map("delivery_note_files") // Object Array: [{ fileName, fileUrl, fileType, fileSize }]
  lotNumber          String?  @map("lot_number") // LOT number untuk traceability (opsional)
  supplierLotNumber  String?  @map("supplier_lot_number") // LOT/batch number dari supplier/vendor
  rackCode           String?  @map("rack_code") // Rack tujuan per item (opsional, override default warehouse putaway)
  uomCode            String?  @map("uom_code")
  unitPrice          Float    @default(0) @map("unit_price") // Snapshot dari PO untuk historical tracking
  totalPrice         Float    @default(0) @map("total_price") // qtyReceived * unitPrice
  notes              String?
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  gr                        GoodsReceipt               @relation(fields: [grNumber], references: [grNumber], onDelete: Cascade)
  poDetail                  PurchaseOrderDetail        @relation(fields: [poDetailId], references: [id])
  rack                      Rack?                      @relation(fields: [rackCode], references: [rackCode])
  incomingInspectionDetails IncomingInspectionDetail[]
  purchaseInvoiceDetails    PurchaseInvoiceDetail[]

  @@index([grNumber])
  @@index([poDetailId])
  @@index([deliveryNoteNumber])
  @@index([lotNumber])
  @@index([supplierLotNumber])
  @@index([rackCode])
  @@index([isDeleted])
  @@map("tbl_goods_receipt_detail")
}

// ============================================
// PURCHASING - PURCHASE INVOICE
// ============================================

model PurchaseInvoice {
  id                    String    @id @default(uuid())
  invoiceNumber         String    @unique @map("invoice_number")
  supplierInvoiceNumber String    @map("supplier_invoice_number")
  invoiceDate           DateTime  @default(now()) @map("invoice_date")
  dueDate               DateTime? @map("due_date")
  poNumber              String    @map("po_number")
  supplierCode          String?   @map("supplier_code")
  supplierName          String?   @map("supplier_name")
  vendorCode            String?   @map("vendor_code")
  vendorName            String?   @map("vendor_name")
  currencyCode          String    @default("IDR") @map("currency_code")
  subtotalAmount        Float     @default(0) @map("subtotal_amount")
  discountAmount        Float     @default(0) @map("discount_amount")
  taxAmount             Float     @default(0) @map("tax_amount")
  totalAmount           Float     @default(0) @map("total_amount")
  status                String    @default("Draft") // Draft, Submitted, Matched, Need Review, Approved, Posted, Paid, Cancelled
  matchStatus           String    @default("Unchecked") @map("match_status") // Unchecked, Matched, Variance
  invoiceFiles          Json?     @map("invoice_files") // [{ fileName, fileUrl, fileType, fileSize }]
  notes                 String?
  createdBy             String?   @map("created_by")
  submittedBy           String?   @map("submitted_by")
  submittedDate         DateTime? @map("submitted_date")
  approvedBy            String?   @map("approved_by")
  approvedDate          DateTime? @map("approved_date")
  paidBy                String?   @map("paid_by")
  paidDate              DateTime? @map("paid_date")
  isDeleted             Boolean   @default(false) @map("is_deleted")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  po             PurchaseOrder            @relation("PurchaseInvoicePrimaryPO", fields: [poNumber], references: [poNumber], onDelete: Restrict)
  supplier       Supplier?                @relation(fields: [supplierCode], references: [supplierCode], onDelete: SetNull)
  vendor         Vendor?                  @relation(fields: [vendorCode], references: [vendorCode], onDelete: SetNull)
  currency       Currency                 @relation(fields: [currencyCode], references: [currencyCode])
  details        PurchaseInvoiceDetail[]
  payments       PurchaseInvoicePayment[]
  purchaseOrders PurchaseInvoicePO[]

  @@index([invoiceNumber])
  @@index([supplierInvoiceNumber])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([poNumber])
  @@index([supplierCode])
  @@index([vendorCode])
  @@index([currencyCode])
  @@index([status])
  @@index([matchStatus])
  @@index([isDeleted])
  @@map("tbl_purchase_invoice")
}

model PurchaseInvoicePO {
