  @@index([planNumber])
  @@index([planMonth])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_monthly_production_plan")
}

model MonthlyProductionPlanDetail {
  id                       String    @id @default(uuid())
  planId                   String    @map("plan_id")
  lineNumber               Int       @map("line_number")
  plannedOrderNumber       String?   @map("planned_order_number")
  manufacturingOrderNumber String?   @map("manufacturing_order_number")
  partCode                 String    @map("part_code")
  partId                   String?   @map("part_id")
  mpsDetailId              String?   @map("mps_detail_id")
  forecastQty              Float     @default(0) @map("forecast_qty")
  actualSalesOrderQty      Float     @default(0) @map("actual_sales_order_qty")
  bufferBaseQty            Float     @default(0) @map("buffer_base_qty")
  bufferPercent            Float     @default(0) @map("buffer_percent")
  bufferQty                Float     @default(0) @map("buffer_qty")
  productionPercent        Float     @default(100) @map("production_percent")
  effectiveDemandQty       Float     @default(0) @map("effective_demand_qty")
  qtyPlanned               Float     @map("qty_planned")
  qtyReleased              Float     @default(0) @map("qty_released")
  uomCode                  String?   @map("uom_code")
  requiredDate             DateTime? @map("required_date")
  priority                 Int       @default(1)
  status                   String    @default("Planned") // Planned, Converted, Cancelled
  notes                    String?
  isDeleted                Boolean   @default(false) @map("is_deleted")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  plan MonthlyProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, lineNumber])
  @@index([planId])
  @@index([plannedOrderNumber])
  @@index([manufacturingOrderNumber])
  @@index([partCode])
  @@index([partId])
  @@index([mpsDetailId])
  @@index([requiredDate])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_monthly_production_plan_detail")
}

// ============================================
// PLANNING - MRP DIRTY ITEM QUEUE
// ============================================

model MRPDirtyItem {
  id           String    @id @default(uuid())
  itemId       String    @map("item_id")
  reason       String // SO, STOCK, BOM, PO, PRODUCTION, FORECAST
  sourceNumber String?   @map("source_number")
  status       String    @default("Pending") // Pending, Processing, Done, Failed
  processedAt  DateTime? @map("processed_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  item Part @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([reason])
  @@index([status])
  @@index([sourceNumber])
  @@map("tbl_mrp_dirty_item")
}

// ============================================
// PLANNING - BOM RELATION GRAPH
// ============================================

model BOMRelation {
  id             String    @id @default(uuid())
  parentItemId   String    @map("parent_item_id")
  childItemId    String    @map("child_item_id")
  mbomHeaderId   String?   @map("mbom_header_id")
  levelComponent Int       @default(0) @map("level_component")
  effectiveDate  DateTime? @map("effective_date")
  expiryDate     DateTime? @map("expiry_date")
  notes          String?
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  parentItem Part        @relation("BOMRelationParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItem  Part        @relation("BOMRelationChild", fields: [childItemId], references: [id], onDelete: Cascade)
  mbomHeader MBOMHeader? @relation(fields: [mbomHeaderId], references: [id], onDelete: SetNull)

  @@unique([parentItemId, childItemId, mbomHeaderId])
  @@index([parentItemId])
  @@index([childItemId])
  @@index([mbomHeaderId])
  @@index([levelComponent])
  @@index([isDeleted])
  @@map("tbl_bom_relation")
}

// ============================================
// PLANNING - ITEM LEVEL
// ============================================

model ItemLevel {
  id         String   @id @default(uuid())
  rootItemId String   @map("root_item_id")
  itemId     String   @map("item_id")
  level      Int      @default(0)
  path       String? // Contoh: FG>A>B>C
  sourceType String?  @map("source_type")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  rootItem Part @relation("ItemLevelRoot", fields: [rootItemId], references: [id], onDelete: Cascade)
  item     Part @relation("ItemLevelItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([rootItemId, itemId])
  @@index([rootItemId])
  @@index([itemId])
  @@index([level])
  @@index([isActive])
  @@map("tbl_item_level")
}

// ============================================
// PLANNING - MRP PEGGING
