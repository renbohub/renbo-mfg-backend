// ============================================
// PLANNING - MONTHLY PRODUCTION PLAN
// ============================================

model MonthlyProductionPlan {
  id                        String    @id @default(uuid())
  planNumber                String    @unique @map("plan_number")
  planMonth                 DateTime  @map("plan_month")
  periodStart               DateTime  @map("period_start")
  periodEnd                 DateTime  @map("period_end")
  status                    String    @default("Draft") // Draft, Confirmed, Released, Closed, Cancelled
  sourceType                String    @default("PlannedOrder") @map("source_type")
  notes                     String?
  confirmedBy               String?   @map("confirmed_by")
  confirmedAt               DateTime? @map("confirmed_at")
  releasedBy                String?   @map("released_by")
  releasedAt                DateTime? @map("released_at")
  capacityOverrideApproved  Boolean   @default(false) @map("capacity_override_approved")
  capacityOverrideReason    String?   @map("capacity_override_reason")
  capacityOverrideBy        String?   @map("capacity_override_by")
  capacityOverrideAt        DateTime? @map("capacity_override_at")
  closedBy                  String?   @map("closed_by")
  closedAt                  DateTime? @map("closed_at")
  createdBy                 String?   @map("created_by")
  recommendationGeneratedAt DateTime? @map("recommendation_generated_at")
  recommendationVersion     String?   @map("recommendation_version")
  recommendationSummary     Json?     @map("recommendation_summary")
  replanRequired            Boolean   @default(false) @map("replan_required")
  replanReason              String?   @map("replan_reason")
  sourceChangedAt           DateTime? @map("source_changed_at")
  lastReplannedAt           DateTime? @map("last_replanned_at")
  planningGranularity       String    @default("DAY") @map("planning_granularity")
  rollingLookbackWeeks      Int       @default(1) @map("rolling_lookback_weeks")
  freezeFenceDays           Int       @default(3) @map("freeze_fence_days")
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  details                  MonthlyProductionPlanDetail[]
  capacityMachineOverrides CapacityMachineOverride[]
  capacityDayOverrides     CapacityDayOverride[]
  manualAllocations        ProductionPlanAllocation[]
  dailyProductionSchedules DailyProductionSchedule[]
  capacityEditSessions     CapacityEditSession[]
  capacityQueueItems       CapacityQueueItem[]
  recommendationScenarios  MonthlyPlanRecommendationScenario[]

  @@index([planNumber])
  @@index([planMonth])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_monthly_production_plan")
}

// Audit trail when Marketing changes delivery commitments after downstream
// planning already exists. It records impact without silently deleting a
// Released production schedule.
model PlanningChangeImpact {
  id                  String    @id @default(uuid())
  changeType          String    @map("change_type") // DELIVERY_TARGET_CHANGED
  sourceType          String    @map("source_type")
  sourceNumber        String    @map("source_number")
  sourceLineId        String?   @map("source_line_id")
  partCode            String?   @map("part_code")
  oldValue            Json?     @map("old_value")
  newValue            Json?     @map("new_value")
  affectedMpsNumbers  Json?     @map("affected_mps_numbers")
  affectedPlanNumbers Json?     @map("affected_plan_numbers")
  status              String    @default("PENDING_REPLAN")
  resolutionNotes     String?   @map("resolution_notes")
  changedBy           String?   @map("changed_by")
  changedAt           DateTime  @default(now()) @map("changed_at")
  resolvedBy          String?   @map("resolved_by")
  resolvedAt          DateTime? @map("resolved_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([sourceType, sourceNumber])
  @@index([status])
  @@index([changedAt])
  @@map("tbl_planning_change_impact")
}

// Override kapasitas bersifat per Production Plan. Routing default MBOM tidak
// diubah; PPIC hanya dapat memilih machine yang telah diset sebagai alternatif
// pada routing BOM dan perubahan tetap memiliki alasan/audit trail.
model CapacityMachineOverride {
  id            String   @id @default(uuid())
  planId        String   @map("plan_id")
  lineNumber    Int      @map("line_number")
  mbomProcessId String   @map("mbom_process_id")
  scheduleDate  DateTime @map("schedule_date")
  machineId     String?  @map("machine_id")
  diesId        String?  @map("dies_id")
  routingMode   String   @default("INHOUSE") @map("routing_mode")
  vendorId      String?  @map("vendor_id")
  reason        String
  changedBy     String?  @map("changed_by")
  changedAt     DateTime @default(now()) @map("changed_at")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  plan        MonthlyProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  machine     Machine?              @relation(fields: [machineId], references: [id])
  vendor      Vendor?               @relation(fields: [vendorId], references: [id])
  dies        Dies?                 @relation(fields: [diesId], references: [id])
  mbomProcess MBOMProcess           @relation(fields: [mbomProcessId], references: [id])

  @@unique([planId, lineNumber, mbomProcessId, scheduleDate])
  @@index([planId])
  @@index([mbomProcessId])
  @@index([machineId])
  @@index([vendorId])
  @@index([diesId])
  @@index([scheduleDate])
  @@index([isDeleted])
  @@map("tbl_capacity_machine_override")
}

model CapacityDayOverride {
  id             String   @id @default(uuid())
  planId         String   @map("plan_id")
  machineId      String?  @map("machine_id")
  scheduleDate   DateTime @map("schedule_date")
  dayStatus      String   @default("WORKING") @map("day_status") // WORKING, HOLIDAY, OVERLOAD
  shiftsPerDay   Int?     @map("shifts_per_day")
  overtimeStart  String?  @map("overtime_start")
  overtimeEnd    String?  @map("overtime_end")
  shiftOverrides Json?    @map("shift_overrides")
  reason         String?
  changedBy      String?  @map("changed_by")
  changedAt      DateTime @default(now()) @map("changed_at")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  plan    MonthlyProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  machine Machine?              @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([planId, machineId, scheduleDate])
  @@index([planId])
  @@index([scheduleDate])
  @@index([isDeleted])
  @@map("tbl_capacity_day_override")
}

// Draft allocation created interactively from Capacity Check before the MPP
// is released and before MO/WO references exist. After MO creation PPIC
// publishes these rows into DailyProductionSchedule.
model ProductionPlanAllocation {
  id                           String    @id @default(uuid())
  planId                       String    @map("plan_id")
  lineNumber                   Int       @map("line_number")
  mbomProcessId                String    @map("mbom_process_id")
  scheduleDate                 DateTime  @map("schedule_date")
  shift                        String
  plannedStartTime             String?   @map("planned_start_time")
  plannedEndTime               String?   @map("planned_end_time")
  machineId                    String?   @map("machine_id")
  diesId                       String?   @map("dies_id")
  routingMode                  String    @default("INHOUSE") @map("routing_mode")
  vendorId                     String?   @map("vendor_id")
  vendorSendDate               DateTime? @map("vendor_send_date")
  vendorReturnDate             DateTime? @map("vendor_return_date")
  vendorLeadTimeDays           Int?      @map("vendor_lead_time_days")
  expectedReturnQty            Float?    @map("expected_return_qty")
  plannedQty                   Float     @map("planned_qty")
  uomCode                      String?   @map("uom_code")
  status                       String    @default("Draft") // Draft, Published, Cancelled
  notes                        String?
  allocationSource             String    @default("MANUAL") @map("allocation_source") // MANUAL, AUTO_RECOMMENDATION
  planningMode                 String    @default("PRODUCTION") @map("planning_mode") // PRODUCTION, SIMULATION
  scenarioKey                  String?   @map("scenario_key") // simulation-1, simulation-2
  recommendationReason         String?   @map("recommendation_reason")
  recommendationScore          Float?    @map("recommendation_score")
  recommendationScoreBreakdown Json?     @map("recommendation_score_breakdown")
  capacityMode                 String?   @map("capacity_mode") // NORMAL, PARALLEL_LANE, EXTRA_SHIFT, OVERTIME
  deliveryPhaseId              String?   @map("delivery_phase_id")
  deliveryPhaseNumber          Int?      @map("delivery_phase_number")
  transferBatchNumber          Int?      @map("transfer_batch_number")
  predecessorAllocationIds     Json?     @map("predecessor_allocation_ids")
  demandSourceType             String?   @map("demand_source_type")
  demandSourceNumber           String?   @map("demand_source_number")
  customerCode                 String?   @map("customer_code")
  customerTargetDate           DateTime? @map("customer_target_date")
  fgRequiredDate               DateTime? @map("fg_required_date")
  priorityScore                Float?    @map("priority_score")
  priorityClass                String?   @map("priority_class")
  latestStartDate              DateTime? @map("latest_start_date")
  latestFinishDate             DateTime? @map("latest_finish_date")
  earliestFeasibleCompletion   DateTime? @map("earliest_feasible_completion")
  capacityLate                 Boolean   @default(false) @map("capacity_late")
  lateConstraintCode           String?   @map("late_constraint_code")
  publishedAt                  DateTime? @map("published_at")
  publishedBy                  String?   @map("published_by")
  createdBy                    String?   @map("created_by")
  isDeleted                    Boolean   @default(false) @map("is_deleted")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  plan                     MonthlyProductionPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  mbomProcess              MBOMProcess               @relation(fields: [mbomProcessId], references: [id])
  machine                  Machine?                  @relation(fields: [machineId], references: [id])
  dies                     Dies?                     @relation(fields: [diesId], references: [id], onDelete: SetNull)
  vendor                   Vendor?                   @relation(fields: [vendorId], references: [id])
  dailyProductionSchedules DailyProductionSchedule[]

  @@index([planId, lineNumber])
  @@index([mbomProcessId])
  @@index([scheduleDate])
  @@index([machineId])
  @@index([diesId])
  @@index([vendorId])
  @@index([vendorSendDate])
  @@index([vendorReturnDate])
  @@index([status])
  @@index([allocationSource])
  @@index([planningMode, scenarioKey])
  @@index([deliveryPhaseId])
  @@index([isDeleted])
  @@map("tbl_production_plan_allocation")
}

model CapacityEditSession {
  id                String                @id @default(uuid())
  planId            String                @map("plan_id")
  scope             String                @default("PLAN")
  status            String                @default("OPEN")
  basePlanUpdatedAt DateTime              @map("base_plan_updated_at")
  snapshot          Json
  createdBy         String?               @map("created_by")
  cancelledBy       String?               @map("cancelled_by")
  cancelledAt       DateTime?             @map("cancelled_at")
  committedBy       String?               @map("committed_by")
  committedAt       DateTime?             @map("committed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  plan              MonthlyProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  changes           CapacityEditChange[]
  queueItems        CapacityQueueItem[]

  @@index([planId, status])
  @@map("tbl_capacity_edit_session")
}

model CapacityEditChange {
  id             String              @id @default(uuid())
  sessionId      String              @map("session_id")
  sequence       Int
  changeType     String              @map("change_type")
  entityType     String              @map("entity_type")
  entityId       String?             @map("entity_id")
  beforeValue    Json?               @map("before_value")
  afterValue     Json                @map("after_value")
  forceRequired  Boolean             @default(false) @map("force_required")
  forceReason    String?             @map("force_reason")
  approvalStatus String              @default("NOT_REQUIRED") @map("approval_status")
  approvedBy     String?             @map("approved_by")
  approvedAt     DateTime?           @map("approved_at")
  createdBy      String?             @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  session        CapacityEditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([entityType, entityId])
  @@map("tbl_capacity_edit_change")
}

model CapacityQueueItem {
  id                 String                @id @default(uuid())
  planId             String                @map("plan_id")
  sessionId          String?               @map("session_id")
  sourceAllocationId String?               @map("source_allocation_id")
  lineNumber         Int                   @map("line_number")
  mbomProcessId      String                @map("mbom_process_id")
  partCode           String?               @map("part_code")
  processCode        String?               @map("process_code")
  qty                Float
  uomCode            String?               @map("uom_code")
  earliestStartDate  DateTime?             @map("earliest_start_date")
  latestFinishDate   DateTime?             @map("latest_finish_date")
  fgRequiredDate     DateTime?             @map("fg_required_date")
  predecessorIds     Json?                 @map("predecessor_ids")
  successorIds       Json?                 @map("successor_ids")
  suggestions        Json?
  status             String                @default("OPEN")
  reason             String?
  createdBy          String?               @map("created_by")
  createdAt          DateTime              @default(now()) @map("created_at")
