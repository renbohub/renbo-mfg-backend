// ============================================
// PRODUCTION - MANUFACTURING ORDER
// ============================================

model ManufacturingOrder {
  id                                    String                        @id @default(uuid())
  moNumber                              String                        @unique @map("mo_number") // MO-YYYYMMDD-001
  moDate                                DateTime                      @default(now()) @map("mo_date")
  // Reference sumber
  referenceType                         String?                       @map("reference_type") // Internal, MRPPlannedOrder
  plannedOrderNumber                    String?                       @map("planned_order_number") // FK ke PlannedOrder.orderNumber (jika referenceType = MRPPlannedOrder)
  monthlyProductionPlanNumber           String?                       @map("monthly_production_plan_number")
  monthlyProductionPlanLineNumber       Int?                          @map("monthly_production_plan_line_number")
  // Part yang diproduksi
  partId                                String?                       @map("part_id")
  // Qty
  qtyPlanned                            Float                         @map("qty_planned")
  uomCode                               String?                       @map("uom_code")
  materialRequirementUomMode            String                        @default("kg") @map("material_requirement_uom_mode") // kg, ORIGINAL, BY_ITEM_TYPE
  qtyProduced                           Float                         @default(0) @map("qty_produced")
  qtyGood                               Float                         @default(0) @map("qty_good")
  qtyReject                             Float                         @default(0) @map("qty_reject")
  // Input source: default MBOM material, optional existing WIP stock
  inputSourceType                       String                        @default("MBOM") @map("input_source_type") // MBOM, WIP_STOCK
  sourceStockBalanceId                  String?                       @map("source_stock_balance_id")
  sourceWarehouseCode                   String?                       @map("source_warehouse_code")
  sourceRackCode                        String?                       @map("source_rack_code")
  sourceLotNumber                       String?                       @map("source_lot_number")
  sourcePartCode                        String?                       @map("source_part_code")
  sourcePartNumber                      String?                       @map("source_part_number")
  sourcePartName                        String?                       @map("source_part_name")
  sourceStockType                       String?                       @map("source_stock_type")
  sourceQtyPlanned                      Float?                        @map("source_qty_planned")
  parentMoNumber                        String?                       @map("parent_mo_number")
  rootMoNumber                          String?                       @map("root_mo_number")
  sourceReferenceType                   String?                       @map("source_reference_type")
  sourcePlannedOrderNumber              String?                       @map("source_planned_order_number")
  sourceMonthlyProductionPlanNumber     String?                       @map("source_monthly_production_plan_number")
  sourceMonthlyProductionPlanLineNumber Int?                          @map("source_monthly_production_plan_line_number")
  sourceStartSequence                   Int?                          @map("source_start_sequence")
  sourceStartProcessLabel               String?                       @map("source_start_process_label")
  sourceReworkTraceType                 String?                       @map("source_rework_trace_type")
  sourceReworkReferenceType             String?                       @map("source_rework_reference_type")
  sourceReworkReferenceNumber           String?                       @map("source_rework_reference_number")
  sourceReworkReferenceLabel            String?                       @map("source_rework_reference_label")
  isReworkChild                         Boolean                       @default(false) @map("is_rework_child")
  // Schedule
  plannedStartDate                      DateTime?                     @map("planned_start_date")
  plannedEndDate                        DateTime?                     @map("planned_end_date")
  actualStartDate                       DateTime?                     @map("actual_start_date")
  actualEndDate                         DateTime?                     @map("actual_end_date")
  // Status
  status                                String                        @default("Draft") @map("status") // Draft, Planned, Released, In Progress, Completed, Cancelled
  notes                                 String?
  createdBy                             String?                       @map("created_by")
  isDeleted                             Boolean                       @default(false) @map("is_deleted")
  createdAt                             DateTime                      @default(now()) @map("created_at")
  updatedAt                             DateTime                      @updatedAt @map("updated_at")
  // Relations
  part                                  Part?                         @relation(fields: [partId], references: [id], onDelete: SetNull)
  uom                                   Uom?                          @relation(fields: [uomCode], references: [uomCode], onDelete: SetNull)
  sourceStockBalance                    StockBalance?                 @relation("ManufacturingOrderSourceWip", fields: [sourceStockBalanceId], references: [id], onDelete: SetNull)
  sourceWipAllocations                  ManufacturingOrderSourceWip[]
  workOrders                            WorkOrder[]
  productionLogs                        ProductionLog[]
  downtimeLogs                          DowntimeLog[]
  qualityInspections                    QualityInspection[]
  materialIssues                        MaterialIssue[]
  wipEntries                            WIPEntry[]

  @@index([moNumber])
  @@index([referenceType])
  @@index([plannedOrderNumber])
  @@index([monthlyProductionPlanNumber])
  @@index([monthlyProductionPlanLineNumber])
  @@index([partId])
  @@index([uomCode])
  @@index([inputSourceType])
  @@index([sourceStockBalanceId])
  @@index([parentMoNumber])
  @@index([rootMoNumber])
  @@index([sourceReferenceType])
  @@index([sourcePlannedOrderNumber])
  @@index([sourceStartSequence])
  @@index([isReworkChild])
  @@index([status])
  @@index([plannedStartDate])
  @@index([plannedEndDate])
  @@index([isDeleted])
  @@map("tbl_manufacturing_order")
}

