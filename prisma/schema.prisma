// ============================================
// PURCHASING - PURCHASE REQUISITION (PR)
// ============================================

model PurchaseRequisition {
  id                 String    @id @default(uuid())
  prNumber           String    @unique @map("pr_number")
  prDate             DateTime  @default(now()) @map("pr_date")
  requestedBy        String?   @map("requested_by")
  departmentId       String?   @map("department_id")
  requiredDate       DateTime  @map("required_date")
  priority           String    @default("Normal") // Normal, Urgent, Critical
  poType             String    @default("Other") @map("po_type") // Consumable, Material, Out Process, Maintenance, Service, Asset, Other
  sourceType         String    @default("MANUAL") @map("source_type") // MANUAL, MRP, SYSTEM; explicit origin for audit/filtering
  procurementGroup   String?   @map("procurement_group") // MATERIAL, PURCHASE_PART, UNIVERSAL_PURCHASE_PART, NON_PRODUCTION; nullable untuk PR legacy/mixed
  headerMaterialId   String?   @map("header_material_id") // Material Master identity for raw-material PR headers
  headerMaterialCode String?   @map("header_material_code")
  headerMaterialName String?   @map("header_material_name")
  demandBucket       String?   @map("demand_bucket") // YYYY-MM; prevents unrelated due periods from being merged
  warehouseCode      String?   @map("warehouse_code")
  status             String    @default("Draft") // Draft, Submitted, Approved, Rejected, Partially Ordered, Completed
  totalAmount        Float     @default(0) @map("total_amount")
  approvedBy         String?   @map("approved_by")
  approvedDate       DateTime? @map("approved_date")
  rejectedBy         String?   @map("rejected_by")
  rejectedDate       DateTime? @map("rejected_date")
  rejectionReason    String?   @map("rejection_reason")
  convertedToPO      String?   @map("converted_to_po") // PO Number
  notes              String?
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  details        PurchaseRequisitionDetail[]
  purchaseOrders PurchaseOrderPR[]
  department     Department?                 @relation(fields: [departmentId], references: [id])

  @@index([prNumber])
  @@index([prDate])
  @@index([requestedBy])
  @@index([departmentId])
  @@index([priority])
  @@index([poType])
  @@index([sourceType])
  @@index([procurementGroup])
  @@index([headerMaterialId])
  @@index([headerMaterialCode])
  @@index([demandBucket])
  @@index([warehouseCode])
  @@index([status])
  @@index([requiredDate])
  @@index([isDeleted])
  @@map("tbl_purchase_requisition")
}

// ============================================
// PURCHASING - PURCHASE REQUISITION DETAIL
// ============================================

model PurchaseRequisitionDetail {
  id                        String    @id @default(uuid())
  prNumber                  String    @map("pr_number")
  lineNumber                Int       @map("line_number")
  procurementCategory       String?   @map("procurement_category") // Klasifikasi purchasing yang disimpan; fallback ke master untuk data legacy
  partCode                  String?   @map("part_code") // untuk Material, Out Process
  partNumber                String?   @map("part_number")
  partName                  String?   @map("part_name")
  materialId                String?   @map("material_id") // Snapshot reference Material Master; nullable untuk legacy/manual PR
  materialCode              String?   @map("material_code")
  materialName              String?   @map("material_name")
  materialType              String?   @map("material_type")
  productId                 String?   @map("product_id") // untuk Consumable
  description               String?   @map("description") // untuk Maintenance, Service, Asset
  spec                      String? // Snapshot dari PartBase Material Specification
  thickness                 Float? // Snapshot dari PartBase
  width                     Float? // Snapshot dari PartBase
  materialLength            Float?    @map("material_length") // Panjang manual saat bentuk pembelian SHEET
  CSP                       String?   @map("CSP") // Snapshot dari PartBase
  qty                       Float
  orderedQty                Float     @default(0) @map("ordered_qty") // Total qty yang sudah di-PO-kan
  uomCode                   String?   @map("uom_code")
  estimatedPrice            Float     @default(0) @map("estimated_price")
  totalAmount               Float     @default(0) @map("total_amount")
  preferredSupplier         String?   @map("preferred_supplier")
  proposedSupplierCode      String?   @map("proposed_supplier_code") // Proposal supplier dari layer PPIC/MRP
  confirmedSupplierCode     String?   @map("confirmed_supplier_code") // Konfirmasi supplier layer Purchasing/PR
  supplierConfirmedBy       String?   @map("supplier_confirmed_by")
  supplierConfirmedAt       DateTime? @map("supplier_confirmed_at")
  supplierProposalSource    String?   @map("supplier_proposal_source") // PART_MASTER, PPIC, atau PURCHASING
  lotCount                  Float?    @map("lot_count")
  kgPerLot                  Float?    @map("kg_per_lot")
  purchaseQtyKg             Float?    @map("purchase_qty_kg")
  lotAllocations            Json?     @map("lot_allocations") // Pegging lot ke beberapa part/FG
  purchasePackageQty        Float?    @map("purchase_package_qty")
  purchasePackageUomCode    String?   @map("purchase_package_uom_code")
  conversionUomCode         String?   @map("conversion_uom_code")
  conversionFactor          Float?    @map("conversion_factor")
  convertedPurchaseQty      Float?    @map("converted_purchase_qty")
  recommendedPurchaseForms  Json?     @map("recommended_purchase_forms") // BOM/MRP suggestion only; Purchasing remains free to choose
  preferredVendor           String?   @map("preferred_vendor")
  plannedOrderNumber        String?   @map("planned_order_number") // Reference dari MRP
  sourcePlannedOrderNumbers Json?     @map("source_planned_order_numbers") // Semua planned order saat kebutuhan material dikonsolidasi
  notes                     String?
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  // Relations
  pr                  PurchaseRequisition                     @relation(fields: [prNumber], references: [prNumber], onDelete: Cascade)
  product             Product?                                @relation(fields: [productId], references: [id], onDelete: SetNull)
  poDetails           PurchaseOrderDetail[]
  sources             PurchaseRequisitionSource[]
  sourcingAllocations PurchaseRequisitionSourcingAllocation[]

  @@index([prNumber])
  @@index([procurementCategory])
  @@index([partCode])
  @@index([materialCode])
  @@index([productId])
  @@index([preferredSupplier])
  @@index([proposedSupplierCode])
  @@index([confirmedSupplierCode])
  @@index([preferredVendor])
  @@index([plannedOrderNumber])
  @@index([isDeleted])
  @@map("tbl_purchase_requisition_detail")
}

// Allocation/pegging terstruktur untuk satu baris PR yang dapat menggabungkan
