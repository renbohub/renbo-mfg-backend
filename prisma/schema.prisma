  demandType       String   @map("demand_type") // Forecast, SO, MPS, MRP
  demandNumber     String   @map("demand_number")
  demandLineNumber Int?     @map("demand_line_number")
  supplyType       String   @map("supply_type") // PlannedOrder, MO, PO
  supplyNumber     String   @map("supply_number")
  supplyLineNumber Int?     @map("supply_line_number")
  itemId           String   @map("item_id")
  qtyPegged        Float    @map("qty_pegged")
  status           String   @default("Active") // Active, Released, Closed
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  item Part @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([demandType])
  @@index([demandNumber])
  @@index([supplyType])
  @@index([supplyNumber])
  @@index([itemId])
  @@index([status])
  @@map("tbl_mrp_pegging")
}

// ============================================
// PLANNING - MRP PARTIAL SNAPSHOT
// ============================================

model MRPPartialSnapshot {
  id             String    @id @default(uuid())
  snapshotNumber String    @unique @map("snapshot_number")
  snapshotDate   DateTime  @default(now()) @map("snapshot_date")
  runScope       String    @default("Partial") @map("run_scope")
