  totalPoFirmQty      Float     @default(0) @map("total_po_firm_qty")
  totalConsumedFccQty Float     @default(0) @map("total_consumed_fcc_qty")
  totalUnplannedPoQty Float     @default(0) @map("total_unplanned_po_qty")
  totalEffQty         Float     @default(0) @map("total_eff_qty")
