// ============================================
// PLANNING - MRP RUN (MRP Execution Header)
// ============================================

model MRPRun {
  id                    String    @id @default(uuid())
  runNumber             String    @unique @map("run_number")
  planNumber            String?   @map("plan_number")
  planRevision          Int       @default(1) @map("plan_revision")
  planScope             String?   @map("plan_scope") // MPS, SO, Manual
  isCurrentPlan         Boolean   @default(true) @map("is_current_plan")
  runDate               DateTime  @default(now()) @map("run_date")
  mpsNumber             String?   @map("mps_number") // Reference ke MPS
  planHorizon           Int       @default(90) @map("plan_horizon") // Planning horizon in days
  cutoffDate            DateTime  @map("cutoff_date") // Cut-off date untuk calculation
  planningSnapshotAt    DateTime  @default(now()) @map("planning_snapshot_at")
  scenarioKey           String?   @map("scenario_key")
  scenarioName          String?   @map("scenario_name")
  scenarioStatus        String    @default("DRAFT") @map("scenario_status") // DRAFT, SIMULATED, APPROVED, SUPERSEDED
  scenarioAssumptions   Json?     @map("scenario_assumptions")
  status                String    @default("Running") // Running, Completed, Failed
  totalRequirements     Int       @default(0) @map("total_requirements") // Total requirement lines generated
  totalPlannedOrders    Int       @default(0) @map("total_planned_orders") // Total planned orders
  soDemandConsumedQty   Float     @default(0) @map("so_demand_consumed_qty")
  soDemandImpactedLines Int       @default(0) @map("so_demand_impacted_lines")
  nettingSummary        Json?     @map("netting_summary")
  executionTime         Int?      @map("execution_time") // Execution time in seconds
  errorMessage          String?   @map("error_message")
  notes                 String?
  runBy                 String?   @map("run_by")
  planningMonth         DateTime? @map("planning_month")
  planKind              String    @default("BASELINE") @map("plan_kind")
  baselineRunNumber     String?   @map("baseline_run_number")
  sourceDeltaMpsNumber  String?   @map("source_delta_mps_number")
  lockedAt              DateTime? @map("locked_at")
  lockedBy              String?   @map("locked_by")
  isDeleted             Boolean   @default(false) @map("is_deleted")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  mps           MPS?             @relation(fields: [mpsNumber], references: [mpsNumber])
  requirements  MRPRequirement[]
  plannedOrders PlannedOrder[]

  @@index([runNumber])
  @@index([planNumber])
  @@index([planNumber, planRevision])
  @@index([isCurrentPlan])
  @@index([runDate])
  @@index([mpsNumber])
  @@index([status])
  @@index([scenarioKey])
  @@index([scenarioStatus])
  @@index([planKind, baselineRunNumber, sourceDeltaMpsNumber])
  @@index([isDeleted])
  @@map("tbl_mrp_run")
}

// ============================================
// PLANNING - MRP REQUIREMENT
// ============================================

model MRPRequirement {
  id                          String    @id @default(uuid())
  runNumber                   String    @map("run_number")
  parentRequirementId         String?   @map("parent_requirement_id")
  rootRequirementId           String?   @map("root_requirement_id")
  treePath                    String?   @map("tree_path")
  levelMBOM                   Int       @default(0) @map("level_mbom") // BOM level (0=FG, 1=sub-assy, 2=component)
  mbomLevelComponent          Int?      @map("mbom_level_component")
  mbomDetailId                String?   @map("mbom_detail_id")
  partCode                    String    @map("part_code")
  partId                      String?   @map("part_id")
  requirementType             String    @map("requirement_type") // Independent (dari MPS), Dependent (dari BOM explosion)
  sourceType                  String?   @map("source_type") // MPS, SO, FORECAST
  sourceNumber                String?   @map("source_number")
  rootDemandSourceType        String?   @map("root_demand_source_type")
  rootDemandSourceNumber      String?   @map("root_demand_source_number")
  deliveryTargetId            String?   @map("delivery_target_id")
  customerCode                String?   @map("customer_code")
  fgPartCode                  String?   @map("fg_part_code")
  targetDeliveryDate          DateTime? @map("target_delivery_date")
  parentRequiredDate          DateTime? @map("parent_required_date")
  materialRequiredDate        DateTime? @map("material_required_date")
  productionRequiredDate      DateTime? @map("production_required_date")
  supplierRequiredArrivalDate DateTime? @map("supplier_required_arrival_date")
  vendorSendDate              DateTime? @map("vendor_send_date")
  vendorReturnDate            DateTime? @map("vendor_return_date")
  priorityScore               Float?    @map("priority_score")
  priorityClass               String?   @map("priority_class")
  customerPegging             Json?     @map("customer_pegging")
  mpsDetailId                 String?   @map("mps_detail_id") // FK ke MPSDetail untuk traceability MPS → MRP
  requiredDate                DateTime  @map("required_date")
  grossRequirement            Float     @map("gross_requirement") // Total requirement
  forecastQty                 Float     @default(0) @map("forecast_qty")
  soConsumedQty               Float     @default(0) @map("so_consumed_qty")
  effectiveDemandQty          Float     @default(0) @map("effective_demand_qty")
  bufferBaseQty               Float     @default(0) @map("buffer_base_qty") // Demand purchase part pada bulan A+1
  bufferPercent               Float     @default(0) @map("buffer_percent") // Default master Part, dapat dioverride per bucket MRP
  bufferQty                   Float     @default(0) @map("buffer_qty") // bufferBaseQty * bufferPercent / 100
  bufferOverridden            Boolean   @default(false) @map("buffer_overridden")
  bufferReferenceScope        String    @default("PARENT_FG") @map("buffer_reference_scope")
  consumptionSources          Json?     @map("consumption_sources")
  onHandQty                   Float     @default(0) @map("on_hand_qty") // Stock tersedia
  allocatedQty                Float     @default(0) @map("allocated_qty") // Reserved stock
  firmSupplyQty               Float     @default(0) @map("firm_supply_qty")
  plannedSupplyQty            Float     @default(0) @map("planned_supply_qty")
  netRequirement              Float     @map("net_requirement") // Gross - OnHand - Allocated
  firmNetRequirement          Float     @default(0) @map("firm_net_requirement")
  atRiskSupplyQty             Float     @default(0) @map("at_risk_supply_qty")
  projectedAvailableQty       Float     @default(0) @map("projected_available_qty")
  firmProjectedAvailableQty   Float     @default(0) @map("firm_projected_available_qty")
  supplyTimeline              Json?     @map("supply_timeline")
  plannedOrderQty             Float     @default(0) @map("planned_order_qty") // Qty planned order
  orderPercent                Float     @default(100) @map("order_percent") // Override PPIC atas forecast; SO tetap minimum
  adjustedOrderQty            Float     @default(0) @map("adjusted_order_qty") // Qty setelah Order % dan netting stock
  orderType                   String?   @map("order_type") // Purchase, Production
  leadTime                    Int       @default(0) @map("lead_time") // Lead time in days
  orderDate                   DateTime? @map("order_date") // Calculated order date
  latestPrDate                DateTime? @map("latest_pr_date")
  procurementWindow           String?   @map("procurement_window")
  scheduleSource              String?   @map("schedule_source")
  notes                       String?
  isDeleted                   Boolean   @default(false) @map("is_deleted")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  // Relations
  mrpRun            MRPRun           @relation(fields: [runNumber], references: [runNumber], onDelete: Cascade)
  parentRequirement MRPRequirement?  @relation("MRPRequirementTree", fields: [parentRequirementId], references: [id], onDelete: SetNull)
  children          MRPRequirement[] @relation("MRPRequirementTree")
  part              Part?            @relation(fields: [partId], references: [id], onDelete: SetNull)
  mpsDetail         MPSDetail?       @relation(fields: [mpsDetailId], references: [id], onDelete: SetNull)
  mbomDetail        MBOMDetail?      @relation(fields: [mbomDetailId], references: [id], onDelete: SetNull)

  @@index([runNumber])
  @@index([parentRequirementId])
  @@index([rootRequirementId])
  @@index([treePath])
  @@index([levelMBOM])
  @@index([mbomLevelComponent])
  @@index([mbomDetailId])
  @@index([partCode])
  @@index([partId])
  @@index([requirementType])
  @@index([sourceType])
  @@index([sourceNumber])
  @@index([deliveryTargetId])
  @@index([customerCode, targetDeliveryDate])
  @@index([mpsDetailId])
  @@index([requiredDate])
  @@index([orderType])
  @@index([latestPrDate])
  @@index([procurementWindow])
  @@index([isDeleted])
  @@map("tbl_mrp_requirement")
}

// ============================================
// PLANNING - PLANNED ORDER
// ============================================

model PlannedOrder {
  id                     String   @id @default(uuid())
  orderNumber            String   @unique @map("order_number")
  runNumber              String?  @map("run_number") // Nullable: SO-driven planned order tidak punya runNumber
  orderType              String   @map("order_type") // Purchase, Production
  partCode               String   @map("part_code")
  partId                 String?  @map("part_id")
  qty                    Float
  qtyReleased            Float    @default(0) @map("qty_released")
  uomCode                String?  @map("uom_code")
  requiredDate           DateTime @map("required_date")
  orderDate              DateTime @map("order_date") // Planned order date (required - lead time)
  supplierCode           String?  @map("supplier_code") // Untuk purchase orders
  supplierProposalSource String?  @map("supplier_proposal_source") // PART_MASTER atau PPIC
  lotCount               Float?   @map("lot_count") // Jumlah lot yang dibeli (khusus raw material)
  kgPerLot               Float?   @map("kg_per_lot") // Berat aktual yang dipilih PPIC untuk setiap lot
  purchaseQtyKg          Float?   @map("purchase_qty_kg") // purchaseLotQty * kgPerLot
  lotAllocations         Json?    @map("lot_allocations") // Alokasi satu lot ke beberapa child part/FG/source demand
  purchasePackageQty     Float?   @map("purchase_package_qty")
  purchasePackageUomCode String?  @map("purchase_package_uom_code")
  conversionUomCode      String?  @map("conversion_uom_code")
  conversionFactor       Float?   @map("conversion_factor")
  convertedPurchaseQty   Float?   @map("converted_purchase_qty")
  vendorCode             String?  @map("vendor_code") // Untuk vendor orders
  mbomHeaderId           String?  @map("mbom_header_id") // Untuk manufacturing orders
  referenceType          String?  @map("reference_type") // SO, MRP, dll
  referenceNumber        String?  @map("reference_number") // soNumber#lineNumber atau mrpRunNumber
  status                 String   @default("Planned") // Planned, Monthly Planned, Partially Released, Released, Covered, Cancelled
  priority               Int      @default(1)
  notes                  String?
  isDeleted              Boolean  @default(false) @map("is_deleted")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  mrpRun MRPRun? @relation(fields: [runNumber], references: [runNumber], onDelete: Cascade)
  part   Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([orderNumber])
  @@index([runNumber])
  @@index([orderType])
  @@index([partCode])
  @@index([partId])
  @@index([requiredDate])
  @@index([orderDate])
  @@index([supplierCode])
  @@index([supplierProposalSource])
  @@index([vendorCode])
  @@index([mbomHeaderId])
  @@index([referenceType])
  @@index([referenceNumber])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_planned_order")
}

// Purchasing recommendation generated from MRP. This layer deliberately sits
// between PlannedOrder and PurchaseRequisition so supplier feasibility can be
// confirmed without mutating the original planning demand.
model PurchaseSuggestion {
  id               String   @id @default(uuid())
  suggestionNumber String   @unique @map("suggestion_number")
  runNumber        String   @map("run_number")
  warehouseCode    String?  @map("warehouse_code")
  status           String   @default("Draft") // Draft, Waiting Supplier Confirmation, Confirmed, Partially Confirmed, Converted to PR, Cancelled
  generatedBy      String?  @map("generated_by")
  notes            String?
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  items PurchaseSuggestionItem[]

  @@index([runNumber])
  @@index([warehouseCode])
  @@index([status])
  @@index([isDeleted])
  @@map("tbl_purchase_suggestion")
}

model PurchaseSuggestionItem {
  id                          String    @id @default(uuid())
  suggestionNumber            String    @map("suggestion_number")
  plannedOrderNumber          String    @map("planned_order_number")
  mrpRequirementId            String?   @map("mrp_requirement_id")
  partId                      String?   @map("part_id")
  partCode                    String?   @map("part_code")
  partNumber                  String?   @map("part_number")
  partName                    String?   @map("part_name")
  materialId                  String?   @map("material_id")
  materialCode                String?   @map("material_code")
  materialDescription         String?   @map("material_description")
  uomCode                     String?   @map("uom_code")
  warehouseCode               String?   @map("warehouse_code")
  sourceRequirements          Json?     @map("source_requirements")
  customerCodes               Json?     @map("customer_codes")
  salesOrderNumbers           Json?     @map("sales_order_numbers")
  forecastNumbers             Json?     @map("forecast_numbers")
  productionOrderNumbers      Json?     @map("production_order_numbers")
  customerDeliveryDate        DateTime? @map("customer_delivery_date")
  plannedProductionStart      DateTime? @map("planned_production_start")
  materialRequiredDate        DateTime  @map("material_required_date")
  recommendedOrderDate        DateTime  @map("recommended_order_date")
  latestPrDate                DateTime? @map("latest_pr_date")
  procurementWindow           String?   @map("procurement_window")
  scheduleSource              String?   @map("schedule_source")
  productionLeadTimeHours     Float     @default(0) @map("production_lead_time_hours")
  productionLeadTimeBreakdown Json?     @map("production_lead_time_breakdown")
  purchasingLeadTimeDays      Int       @default(0) @map("purchasing_lead_time_days")
  setupTimeMinutes            Float     @default(0) @map("setup_time_minutes")
  cycleTimeSeconds            Float     @default(0) @map("cycle_time_seconds")
  queueBufferHours            Float     @default(0) @map("queue_buffer_hours")
  grossRequirement            Float     @default(0) @map("gross_requirement")
  onHandStock                 Float     @default(0) @map("on_hand_stock")
  reservedStock               Float     @default(0) @map("reserved_stock")
  availableStock              Float     @default(0) @map("available_stock")
  openPoQty                   Float     @default(0) @map("open_po_qty")
  atRiskSupplyQty             Float     @default(0) @map("at_risk_supply_qty")
  netRequirement              Float     @default(0) @map("net_requirement")
  recommendedPurchaseQty      Float     @default(0) @map("recommended_purchase_qty")
  moq                         Float     @default(0)
  orderMultiple               Float     @default(0) @map("order_multiple")
  excessQty                   Float     @default(0) @map("excess_qty")
  projectedStockAfterOrder    Float     @default(0) @map("projected_stock_after_order")
  suggestedSupplierCode       String?   @map("suggested_supplier_code")
  suggestedSupplierName       String?   @map("suggested_supplier_name")
  estimatedUnitPrice          Float?    @map("estimated_unit_price")
  currencyCode                String?   @map("currency_code")
  priceSource                 String?   @map("price_source")
  priceEffectiveFrom          DateTime? @map("price_effective_from")
  priceEffectiveUntil         DateTime? @map("price_effective_until")
  confirmationStatus          String    @default("Not Confirmed") @map("confirmation_status")
  confirmedQty                Float?    @map("confirmed_qty")
  confirmedDeliveryDate       DateTime? @map("confirmed_delivery_date")
  confirmedMoq                Float?    @map("confirmed_moq")
  confirmedLeadTimeDays       Int?      @map("confirmed_lead_time_days")
  confirmedMaterialWidth      Float?    @map("confirmed_material_width")
  confirmedMaterialLength     Float?    @map("confirmed_material_length")
  purchasePackageUomCode      String?   @map("purchase_package_uom_code")
  supplierRemark              String?   @map("supplier_remark")
  alternativeSupplierCode     String?   @map("alternative_supplier_code")
  alternativeMaterialCode     String?   @map("alternative_material_code")
  bypassConfirmationReason    String?   @map("bypass_confirmation_reason")
  shortageQty                 Float     @default(0) @map("shortage_qty")
  qtyConvertedToPr            Float     @default(0) @map("qty_converted_to_pr")
  prNumber                    String?   @map("pr_number")
  status                      String    @default("Draft") // Draft, Waiting Supplier Confirmation, Ready for PR, Partially Ready, Partially Converted to PR, Converted to PR, Cancelled
  isDeleted                   Boolean   @default(false) @map("is_deleted")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  suggestion          PurchaseSuggestion                     @relation(fields: [suggestionNumber], references: [suggestionNumber], onDelete: Cascade)
  supplierAllocations PurchaseSuggestionSupplierAllocation[]

  @@unique([suggestionNumber, plannedOrderNumber])
  @@index([plannedOrderNumber])
  @@index([mrpRequirementId])
  @@index([partCode])
  @@index([materialCode])
  @@index([warehouseCode])
  @@index([materialRequiredDate])
  @@index([recommendedOrderDate])
  @@index([latestPrDate])
  @@index([procurementWindow])
  @@index([suggestedSupplierCode])
  @@index([confirmationStatus])
  @@index([status])
  @@index([prNumber])
  @@index([isDeleted])
  @@map("tbl_purchase_suggestion_item")
}

model PurchaseSuggestionSupplierAllocation {
  id                      String    @id @default(uuid())
  suggestionItemId        String    @map("suggestion_item_id")
  supplierCode            String?   @map("supplier_code")
  supplierName            String?   @map("supplier_name")
  confirmationStatus      String    @default("Not Confirmed") @map("confirmation_status")
